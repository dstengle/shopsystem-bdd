#!/usr/bin/env python3
"""Keep the work-queue of a bounded context in .shop/work/: draft work-items and show them (capability work-queue),
return a failed work-item (`work retry`), and run an initiative's work-items through their stages (`work run`, capability supervision).
Keep the backlog in .shop/backlog/: an item from an idea to its delivery, named `b<n>` (capability backlog).
Keep the person's words with the turns around them in .shop/quotes/, named `quote-<n>` (capability conversation)."""
import argparse
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import backlog_cli
import backlog_items
import batch_cli
import conversation_cli
import supervise
import supervise_all
import workqueue
import workqueue_answer
import workqueue_list
import workqueue_note
import workqueue_request
import workqueue_start
import workqueue_status


def cmd_add(args):
    print(workqueue.add(args.root, args.initiative, args.title, args.part_of, args.under, args.accepts))
    return 0


def cmd_withdraw(args):
    if backlog_items.is_item(args.name):
        return backlog_cli.withdraw(args)
    print("%s %s" % (args.name, workqueue.withdraw(args.root, args.name)))
    return 0


def cmd_list(args):
    return workqueue_list.listing(args.root, args.json)


def cmd_show(args):
    if args.target is not None and backlog_items.is_item(args.target):
        return backlog_cli.show(args)
    if args.target is not None:
        return workqueue_list.show(args.root, args.target, args.json)
    if args.json:
        print(json.dumps({"work-items": [{"work-item": n, "initiative": i, "status": s}
                                         for i, n, s in workqueue.items(args.root)],
                          "requests": [{"request": n, "status": s, "turn": t}
                                       for n, s, t, _ in workqueue.requests(args.root)]}))
        return 0
    for initiative, name, status in workqueue.items(args.root):
        print("%s/%s %s" % (initiative, name, status))
    for name, status, turn, _ in workqueue.requests(args.root):
        print("%s %s %s" % (name, status, turn))
    return 0


def cmd_retry(args):
    print("%s %s" % (args.name, workqueue.retry(args.root, args.name)))
    return 0


def cmd_answer(args):
    if backlog_items.is_item(args.name):
        return backlog_cli.answer(args)
    print("%s %s" % (args.name, workqueue_answer.answer(args.root, args.name, args.answer, args.change, args.accept)))
    return 0


def cmd_note(args):
    workqueue_note.note(args.root, args.initiative, args.line)
    return 0


def cmd_status(args):
    return workqueue_status.status(args.root, args.initiative, args.json)


def cmd_request(args):
    workqueue_request.gate(args.root, args.asker, args.source, args.thread, args.raised_for)
    print(workqueue_request.request(args.root, args.title, args.asker, args.lines, args.source, args.thread, args.delegation,
                                     args.raised_for))
    return 0


def cmd_outcome(args):
    import intake_moves
    if intake_moves.handles(args):
        intake_moves.outcome(args.root, args.request, args.line, args.outcome, args.into, args.group, args.reason,
                             args.text)
        return 0
    workqueue_request.outcome(args.root, args.request, args.line, args.outcome)
    return 0


def cmd_ask(args):
    workqueue_request.ask(args.root, args.request, args.line, args.question)
    return 0


def cmd_reply(args):
    workqueue_request.reply(args.root, args.request, args.question, args.answer)
    return 0


def cmd_turn(args):
    workqueue_request.turn(args.root, args.request)
    return 0


def cmd_resolve(args):
    workqueue_request.resolve(args.root, args.request, [(int(n), req, version) for n, req, version in args.line])
    return 0


def cmd_delegate(args):
    workqueue_request.delegate(args.root, args.request, args.delegation)
    return 0


def cmd_start(args):
    print(workqueue_start.start(args.root, args.request))
    return 0


def cmd_run(args):
    if args.initiative is None:
        return supervise_all.run_all(args.root)
    return supervise.run(args.root, args.initiative)


def main(argv=None):
    ap = argparse.ArgumentParser(prog="work", description=__doc__)
    ap.add_argument("--root", default=".", help="the repository (default: the current directory)")
    sub = ap.add_subparsers(dest="cmd", required=True)
    a = sub.add_parser("add", help="draft a work-item")
    a.add_argument("initiative")
    a.add_argument("title")
    a.add_argument("--part-of", required=True)
    a.add_argument("--under", required=True)
    a.add_argument("--accepts", required=True, action="append")
    li = sub.add_parser("list", help="each initiative, request and work-item under .shop/work/, with its status")
    li.add_argument("--json", action="store_true", help="print one JSON object instead of lines")
    s = sub.add_parser("show", help="where an initiative or a work-item stands (default: each work-item and request, with its status)")
    s.add_argument("target", nargs="?", help="an initiative, a work-item or an item b<n>")
    s.add_argument("--json", action="store_true", help="print one JSON object instead of lines")
    w = sub.add_parser("withdraw", help="move a work-item that is neither claimed nor green, or an item b<n>, to withdrawn")
    w.add_argument("name")
    r = sub.add_parser("run", help="take an initiative's work-items through their stages, one claude -p worker at a time")
    r.add_argument("initiative", nargs="?", help="the initiative (default: every one that is neither done nor abandoned)")
    t = sub.add_parser("retry", help="return a failed work-item to the status before that log.jsonl gives in its transition into failed")
    t.add_argument("name")
    n = sub.add_parser("answer", help="answer the question of an awaiting-answer work-item (returning it to the stage that asked), a capability-proposal or an item b<n> that is needs-input")
    n.add_argument("name")
    n.add_argument("answer")
    n.add_argument("--change", action="store_true", help="a reviewer's question: the answer asks for a change (the work-item returns to ready)")
    n.add_argument("--accept", action="store_true", help="a reviewer's question: the answer accepts the work-item as it is (it returns to done)")
    o =sub.add_parser("note", help="append a dated line to an initiative's ledger and commit it")
    o.add_argument("initiative")
    o.add_argument("line")
    u = sub.add_parser("status", help="where an initiative (default: each open one) stands, for a session to start from")
    u.add_argument("initiative", nargs="?")
    u.add_argument("--json", action="store_true", help="print one JSON object instead of text")
    q = sub.add_parser("request", help="take in a request from its asker, open and in the upstream's turn")
    q.add_argument("title")
    q.add_argument("--from", dest="asker", required=True)
    q.add_argument("--lines", required=True, help="a file of the request's lines, one a line")
    q.add_argument("--source", action="append", default=[])
    q.add_argument("--thread")
    q.add_argument("--raised-for", dest="raised_for", help="the request of the asker this one is raised for")
    q.add_argument("--delegation")
    q = sub.add_parser("outcome", help="write the outcome of a line of a request", allow_abbrev=False)
    q.add_argument("request")
    q.add_argument("line", type=int)
    q.add_argument("outcome")
    q.add_argument("--into", help="accepted, on a request taken in as an item: the capability the line goes into")
    q.add_argument("--group", help="with --into: the title of the item's new group (default: the item's title)")
    q.add_argument("--reason", help="the reason, written under the request's ## Reasons")
    q.add_argument("--line", dest="text", help="rewritten: the counter-proposal, appended to the request's lines")
    q = sub.add_parser("ask", help="write the upstream's question on a line of a request")
    q.add_argument("request")
    q.add_argument("line", type=int)
    q.add_argument("question")
    q = sub.add_parser("reply", help="write the asker's answer to a question of a request")
    q.add_argument("request")
    q.add_argument("question", type=int, help="the number of the question answered")
    q.add_argument("answer")
    q = sub.add_parser("turn", help="pass a request's turn to the other side")
    q.add_argument("request")
    q = sub.add_parser("resolve", help="write which requirement holds each accepted line of a request, and in which version")
    q.add_argument("request")
    q.add_argument("--line", nargs=3, action="append", default=[], metavar=("N", "REQUIREMENT", "VERSION"))
    q = sub.add_parser("delegate", help="write the delegation of a request, in place of any it had")
    q.add_argument("request")
    q.add_argument("delegation")
    q = sub.add_parser("start", help="write the initiative an accepted request begins, proposed")
    q.add_argument("request")
    backlog_cli.add_parsers(sub)
    batch_cli.add_parsers(sub)
    conversation_cli.add_parsers(sub)
    args = ap.parse_args(argv)
    try:
        return {"add": cmd_add, "show": cmd_show, "list": cmd_list, "run": cmd_run, "retry": cmd_retry, "answer": cmd_answer,
                "withdraw": cmd_withdraw, "note": cmd_note, "status": cmd_status,
                "request": cmd_request, "outcome": cmd_outcome, "ask": cmd_ask, "reply": cmd_reply, "turn": cmd_turn, "resolve": cmd_resolve,
                "delegate": cmd_delegate, "start": cmd_start, **backlog_cli.COMMANDS, **batch_cli.COMMANDS,
                **conversation_cli.COMMANDS}[args.cmd](args)
    except workqueue.Refused as refused:
        print("work: %s" % refused, file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
