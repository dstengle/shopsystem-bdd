#!/usr/bin/env python3
"""Keep the backlog in .shop/backlog/: an item from an idea to its delivery, named `b<n>` (capability backlog).
Keep the person's words with the turns around them in .shop/quotes/, named `quote-<n>` (capability conversation).
Keep the requests between bounded contexts in .shop/requests/, named `q<n>` (capability requests).
Write a design-decision under spec/decisions/ with `work decision` (capability decision-tiers), and a
record under .shop/records/ with `work record` (capability design-model-check).
Plugin 0.30's queue of initiatives and work-items is frozen under .shop/work/ and read as files (workflow simplification
plan 9)."""
import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import backlog_cli
import backlog_items
import batch_cli
import conversation_cli
import decision_write
import record_write
import request_cli
import request_moves
import request_view
import shop_files


def cmd_withdraw(args):
    return backlog_cli.withdraw(args)


def cmd_list(args):
    return request_view.listing(args.root, args.json)


def cmd_show(args):
    if args.target is None:
        return request_view.listing(args.root, args.json)
    if backlog_items.is_item(args.target):
        return backlog_cli.show(args)
    if conversation_cli.is_quote(args.target):
        return conversation_cli.show(args)
    return request_view.show(args.root, args.target, args.json)


def cmd_answer(args):
    return backlog_cli.answer(args)


def cmd_request(args):
    request_moves.gate(args.root, args.asker, args.source, args.thread, args.raised_for)
    name, url = request_moves.request(args.root, args.title, args.asker, args.ask, args.source, args.thread,
                                      args.raised_for, args.to)
    print("%s %s" % (name, url))
    return 0


def cmd_outcome(args):
    import intake_moves
    intake_moves.outcome(args.root, args.request, args.line, args.outcome, args.into, args.group, args.reason, args.text)
    return 0


def cmd_ask(args):
    request_moves.ask(args.root, args.request, args.line, args.question)
    return 0


def cmd_reply(args):
    request_moves.reply(args.root, args.request, args.question, args.answer)
    return 0


def cmd_turn(args):
    request_moves.turn(args.root, args.request)
    return 0


def cmd_resolve(args):
    request_moves.resolve(args.root, args.request, [(int(n), req, version) for n, req, version in args.line])
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser(prog="work", description=__doc__)
    ap.add_argument("--root", default=".", help="the repository (default: the current directory)")
    sub = ap.add_subparsers(dest="cmd", required=True)
    li = sub.add_parser("list", help="each request with its status, and each observation no source cites")
    li.add_argument("--json", action="store_true", help="print one JSON object instead of lines")
    s = sub.add_parser("show", help="where an item, a request or a quote stands (default: as `work list`)")
    s.add_argument("target", nargs="?", help="an item b<n>, a request q<n> or a quote quote-<n>")
    s.add_argument("--json", action="store_true", help="print one JSON object instead of lines")
    w = sub.add_parser("withdraw", help="move an item b<n> to withdrawn")
    w.add_argument("name")
    n = sub.add_parser("answer", help="answer the question of an item b<n> that is needs-input")
    n.add_argument("name")
    n.add_argument("answer")
    q = sub.add_parser("request", help="ask an upstream (or this context): open the request's issue, and the request")
    q.add_argument("title")
    q.add_argument("--from", dest="asker", required=True)
    q.add_argument("--ask", help="what the asker needs, in its own words (default: the title)")
    q.add_argument("--to", help="the upstream asked, under ## Upstreams (default: the one upstream, or this context)")
    q.add_argument("--source", action="append", default=[])
    q.add_argument("--thread")
    q.add_argument("--raised-for", dest="raised_for", help="the request of the asker this one is raised for")
    q = sub.add_parser("outcome", help="write the outcome of a line of a request", allow_abbrev=False)
    q.add_argument("request")
    q.add_argument("line", type=int)
    q.add_argument("outcome")
    q.add_argument("--into", help="accepted: the capability of this context the line goes into")
    q.add_argument("--group", help="with --into: a group g<n> of the capability, or the title of a new group")
    q.add_argument("--reason", help="the reason, written under the request's ## Reasons")
    q.add_argument("--line", dest="text", help="rewritten: the counter-proposal, appended to the request's lines")
    q = sub.add_parser("ask", help="write the upstream's question on a line of a request")
    q.add_argument("request")
    q.add_argument("line", type=int)
    q.add_argument("question")
    q = sub.add_parser("reply", help="write the asker's answer to a question of a request")
    q.add_argument("request")
    q.add_argument("question", type=int, help="the number of the question answered")
    q.add_argument("answer")
    q = sub.add_parser("turn", help="pass a request's turn to the other side")
    q.add_argument("request")
    q = sub.add_parser("resolve", help="write which requirement holds each accepted line of a request, and in which version")
    q.add_argument("request")
    q.add_argument("--line", nargs=3, action="append", default=[], metavar=("N", "REQUIREMENT", "VERSION"))
    backlog_cli.add_parsers(sub)
    batch_cli.add_parsers(sub)
    conversation_cli.add_parsers(sub)
    decision_write.add_parser(sub)
    record_write.add_parser(sub)
    request_cli.add_parsers(sub)
    args = ap.parse_args(argv)
    try:
        return {"show": cmd_show, "list": cmd_list, "answer": cmd_answer, "withdraw": cmd_withdraw,
                "request": cmd_request, "outcome": cmd_outcome, "ask": cmd_ask, "reply": cmd_reply, "turn": cmd_turn,
                "resolve": cmd_resolve, **backlog_cli.COMMANDS, **batch_cli.COMMANDS,
                **conversation_cli.COMMANDS, **request_cli.COMMANDS, **decision_write.COMMANDS,
                **record_write.COMMANDS}[args.cmd](args)
    except shop_files.Refused as refused:
        print("work: %s" % refused, file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
