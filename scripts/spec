#!/usr/bin/env python3
"""Check a repository's files against design model v5: the graph's rules, and the requirement language's parse."""
# The command; its parts are the sibling modules model_parse (the files' forms), model_facts, model_spec (codified
# files) and model_work (the facts), model_check (check and rules), model_report
# (decisions, parse, lexicon, logic) and model_restates (restates).

import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from adapter_cli_respond import prepare, respond
from model_contract import CONTRACT
from model_forms import cmd_forms

# what scripts/migrate and the migration steps read by loading this file
from model_parse import as_list, frontmatter, scenarios, section  # noqa: F401
from model_report import (  # noqa: F401
    cmd_decisions,
    cmd_lexicon,
    cmd_logic,
    cmd_parse,
    render_decisions,
)
from model_restates import cmd_restates


def cmd_facts(args):
    from model_facts import Model
    print(Model(args.root).read().asp())
    return 0


def cmd_check(args):
    from model_check import check, needing_clingo
    return needing_clingo("check", lambda: check(args))


def cmd_explain(args):
    from model_check import needing_clingo
    return needing_clingo("explain", lambda: __import__("model_explain").explain(args.root, args.requirement))


def cmd_rules(args):
    from model_check import needing_clingo, rules
    from model_rules import catalogue
    if args.write or args.check:
        return needing_clingo("rules", lambda: catalogue(args.root, write=args.write))
    return needing_clingo("rules", lambda: rules(args.json))


def cmd_constructs(args):
    return __import__("model_constructs").catalogue(args.root, write=args.write)


def main(argv=None):
    ap = argparse.ArgumentParser(prog="spec", description=__doc__, epilog=CONTRACT,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--root", default=".")
    sub = ap.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("rules", help="print every rule's code and plain label, the violations first")
    r.add_argument("--json", action="store_true")
    r.add_argument("--write", action="store_true", help="write the rule catalogue grammar/rules.md")
    r.add_argument("--check", action="store_true", help="say whether grammar/rules.md is current")
    k = sub.add_parser("constructs", help="write or check the construct catalogue grammar/constructs.md")
    k.add_argument("--write", action="store_true", help="write the construct catalogue")
    k.add_argument("--check", action="store_true", help="say whether grammar/constructs.md is current")
    sub.add_parser("facts", help="print the facts read from the repository")
    c = sub.add_parser("check", help="solve the facts against model.lp and report")
    c.add_argument("--json", action="store_true")
    c.add_argument("--limit", type=int, default=10, help="rows shown per relation")
    d = sub.add_parser("decisions", help="write spec/decisions/index.md from spec/decisions/")
    d.add_argument("--check", action="store_true")
    p = sub.add_parser("parse", help="parse a line in grammar 4: its tree, or its refusal with a hint")
    p.add_argument("line", nargs="?")
    p.add_argument("--file")
    p.add_argument("--form", action="store_true", help="print each line's logical form in place of its tree")
    p.add_argument("--item", metavar="b<n>", help="read the line with the terms and model lines item b<n> holds laid")
    x = sub.add_parser("lexicon", help="list the terms by category; --check gives v_t4-v_t10")
    x.add_argument("--check", action="store_true")
    g = sub.add_parser("logic", help="the temporal check of the codified requirements")
    g.add_argument("capability", nargs="?", help="a capability, or a requirement's id <capability>#r<n>")
    g.add_argument("--json", action="store_true")
    s = sub.add_parser("restates", help="whether every 0.29 id is restated, dropped or moved")
    s.add_argument("capability", nargs="?")
    s.add_argument("--json", action="store_true")
    e = sub.add_parser("explain", help="print a requirement, what it also means and what takes precedence over it")
    e.add_argument("requirement", help="a requirement's id <capability>#r<n>")
    f = sub.add_parser("forms", help="print every file form: its name, its path pattern and the command that writes it")
    f.add_argument("--json", action="store_true",
                   help="print the forms as JSON, each its name, path, writer and kind (command, item or hand)")
    f.add_argument("--check", action="store_true", help="exit 1 naming each form written by hand")
    a = sub.add_parser("annotate", help="write each operation's governing requirements into the adapter contracts")
    a.add_argument("contract", nargs="*", help="an adapter contract's path (every one of the context by default)")
    a.add_argument("--check", action="store_true", help="exit 1 naming each stale adapter contract, writing nothing")
    __import__("model_catalogue_write").add_parser(sub)
    __import__("product_cli").add_parsers(sub)
    __import__("product_assign_cli").add_parsers(sub)
    __import__("product_drop_cli").add_parsers(sub)
    __import__("product_trace_cli").add_parser(sub)
    __import__("spec_coupling").add_parser(sub)
    q = sub.add_parser("prepare", help="print this bounded context's contract in the contract form, writing nothing")
    q.add_argument("--contract", required=True, metavar="VERSION", help="the version the contract is prepared at")
    u = sub.add_parser("publish", help="keep this bounded context's contract at a version as published, superseding the earlier ones")
    u.add_argument("--version", help="the version it is kept at (the latest kept one's last number one more by default)")
    g = sub.add_parser("fetch", help="print the contract kept as published, or the one kept at a version, writing nothing")
    g.add_argument("--version", help="the version of the contract (the published one by default)")
    o = sub.add_parser("obtain", help="keep an upstream's published contract, or the one at a version, in each adapter spec of the provider")
    o.add_argument("context", metavar="BOUNDED_CONTEXT", help="the upstream's bounded-context id under ## Upstreams")
    o.add_argument("--version", help="the version of the contract (the published one by default)")
    args = prepare(ap).parse_args(argv)
    if args.cmd == "parse" and (args.line is None) == (args.file is None):
        ap.error("parse takes a line or --file, not both")
    if args.cmd == "rules" and args.write + args.check + args.json > 1:
        ap.error("rules takes one of --json, --write and --check")
    if args.cmd == "constructs" and args.write == args.check:
        ap.error("constructs takes one of --write and --check")
    handler = {"facts": cmd_facts, "check": cmd_check, "rules": cmd_rules, "decisions": cmd_decisions,
               "parse": cmd_parse, "lexicon": cmd_lexicon, "logic": cmd_logic, "restates": cmd_restates,
               "forms": cmd_forms, "explain": cmd_explain,
               "annotate": lambda x: __import__("adapter_annotate").annotate(x.root, x.check, x.contract),
               "prepare": lambda x: __import__("contract_form").prepare(x.root, x.contract),
               "publish": lambda x: __import__("contract_publish").publish(x.root, x.version),
               "fetch": lambda x: __import__("contract_publish").fetch(x.root, x.version),
               "obtain": lambda x: __import__("contract_obtain").obtain(x.root, x.context, x.version),
               "constructs": cmd_constructs, "catalogue": lambda x: __import__("model_catalogue_write").cmd(x),
               **__import__("product_cli").COMMANDS, **__import__("product_assign_cli").COMMANDS,
               **__import__("product_drop_cli").COMMANDS,
               **__import__("product_trace_cli").COMMANDS, **__import__("spec_coupling").COMMANDS}[args.cmd]
    return respond("spec", handler, args, checks=args.cmd in ("check", "logic"))


if __name__ == "__main__":
    __import__("adapter_cli_respond").notice("spec")
    sys.exit(main())
