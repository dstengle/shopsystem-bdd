#!/usr/bin/env python3
"""Measure a batch from git and its sessions' transcripts, record a defect found after a merge, and show and compare
measurements, a batch's or a plugin 1.x initiative's (`measure initiative` went with `work run` in 2.0.0)."""
import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import measure_show
import measure_write
from shop_refused import Refused

CONTRACT = """\
contract:
  - batch <batch> writes one measurement at
    .shop/records/measurements/<date>-<batch>.md: the batch's window from the
    git history of its plan, wall time, session time, tokens and cost by role
    (planning, implementing, review, fixing) of the requests inside the window
    of the transcripts in Claude Code's store for this directory (--sessions
    <dir> for another), the review findings by grade, the defects traced to
    their items and the knobs it ran with. Cost is computed from a dated price
    table (.shop/delivery.toml [prices."<model>"] over it); a model with no
    price is named, never guessed. Not written over without --replace.
  - defect <item> --says TEXT records a fault found after the merge at
    .shop/batches/<n>/defect-<k>.md, against the delivered item and its merged
    batch, and commits it alone; measure batch counts it. Anything else is
    refused, changing nothing.

  - show <record> prints a measurement's figures as tables: a batch's, or a
    plugin 1.x initiative's stages, work-items, totals and sessions.
  - compare <a> <b> prints the two measurements' totals side by side with the
    ratio of b to a. Each is a record or batch-<n>, the batch's newest
    measurement; two batches give wall time, session time, tokens, cost,
    defects per item, each role's cost, the findings by grade and the sizes
    (items, changed lines, reviews). A batch's measurement is not compared
    with an initiative's, nor a batch's record lacking a figure compare reads.

exit status: 0 success, 1 refused, 2 bad usage.
"""


def batch(args):
    import measure_batch
    import measure_batch_show
    root = os.getcwd()
    date = measure_write.today()
    path = measure_write.check_unwritten(root, args.batch, date, args.replace)
    figures = measure_batch.figures_of(root, args.batch, args.sessions)
    figures["date"] = date
    text = measure_write.text_of(root, args.batch, date, figures, measure_batch_show.summary(figures))
    measure_write.write(path, text)
    print(os.path.relpath(path, root))


def defect(args):
    import measure_defect
    print(measure_defect.record(os.getcwd(), args.item, args.says))


def show(args):
    print(measure_show.show(args.record), end="")


def compare(args):
    import measure_batch_show
    first, second = (measure_batch_show.resolve(os.getcwd(), word) for word in (args.a, args.b))
    print(measure_show.compare(first, second), end="")


COMMANDS = {"batch": batch, "defect": defect, "show": show, "compare": compare}


def parser():
    top = argparse.ArgumentParser(prog="measure", description=__doc__, epilog=CONTRACT,
                                  formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = top.add_subparsers(dest="command", required=True)
    many = sub.add_parser("batch", help="write a batch's measurement")
    many.add_argument("batch")
    many.add_argument("--sessions", help="a directory of Claude Code transcripts (default: this directory's own)")
    many.add_argument("--replace", action="store_true", help="write over a measurement that exists")
    fault = sub.add_parser("defect", help="record a fault found after the merge against its item")
    fault.add_argument("item")
    fault.add_argument("--says", required=True, help="the fault and how to reproduce it")
    sub.add_parser("show", help="print a measurement's figures as tables").add_argument("record")
    two = sub.add_parser("compare", help="print two measurements' totals side by side with their ratio")
    two.add_argument("a")
    two.add_argument("b")
    return top


def main(argv=None):
    args = parser().parse_args(argv)
    try:
        COMMANDS[args.command](args)
    except Refused as why:
        print("measure %s: %s" % (args.command, why), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
