#!/usr/bin/env python3
"""Measure an initiative's deliveries from what `work run` records, its sessions and git."""
import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import measure_build  # noqa: E402
import measure_show  # noqa: E402
import measure_write  # noqa: E402
from measure_read import Refused  # noqa: E402

CONTRACT = """\
contract:
  - initiative <initiative> writes one measurement at
    .shop/records/measurements/<date>-<initiative>.md, the date being the day it
    is run. It reads .shop/work/<initiative>/log.jsonl, the session.json of each
    stage's directory, git, and each stage's transcript in Claude Code's store
    (CLAUDE_CONFIG_DIR, else ~/.claude, projects/*/<session>.jsonl). A
    measurement that exists is not written over without --replace.
  - It gives each stage with its work-item, agent, session, time (none for a
    stage with no end), turns, round trips (the distinct requests of its
    session's transcript; none when no transcript is found), tokens (output,
    new input, cache read) and cost;
    each work-item with its transitions, its awaiting-answer and failed counts
    and the commits its merge brought in; the totals over the stages' sessions
    and the time from the first transition to the last.
  - --sessions <dir> names a directory of Claude Code transcripts, raw or the
    slim export: the measurement also gives each session that starts inside the
    initiative's window, and each session those dispatched.
  - It writes no prompt, reply or tool content. A file whose shape is not
    known is refused, naming it. An empty session.json is not refused: its
    stage is given without the session's figures, named as such.

  - show <record> prints a measurement's stages, work-items, totals and sessions as tables.
  - compare <a> <b> prints the two measurements' totals side by side with the
    ratio of b to a.

exit status: 0 success, 1 refused, 2 bad usage.
"""


def initiative(args):
    root = os.getcwd()
    date = measure_write.today()
    path = measure_write.check_unwritten(root, args.initiative, date, args.replace)
    figures = measure_build.figures_of(args.initiative, root, args.sessions)
    figures["date"] = date
    measure_write.write(path, measure_write.text_of(root, args.initiative, date, figures))
    print(os.path.relpath(path, root))


def show(args):
    print(measure_show.show(args.record), end="")


def compare(args):
    print(measure_show.compare(args.a, args.b), end="")


COMMANDS = {"initiative": initiative, "show": show, "compare": compare}


def parser():
    top = argparse.ArgumentParser(prog="measure", description=__doc__, epilog=CONTRACT,
                                  formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = top.add_subparsers(dest="command", required=True)
    one = sub.add_parser("initiative", help="write an initiative's measurement")
    one.add_argument("initiative")
    one.add_argument("--sessions", help="a directory of Claude Code transcripts")
    one.add_argument("--replace", action="store_true", help="write over a measurement that exists")
    sub.add_parser("show", help="print a measurement's figures as tables").add_argument("record")
    two = sub.add_parser("compare", help="print two measurements' totals side by side with their ratio")
    two.add_argument("a")
    two.add_argument("b")
    return top


def main(argv=None):
    args = parser().parse_args(argv)
    try:
        COMMANDS[args.command](args)
    except Refused as why:
        print("measure: " + str(why), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
