#!/usr/bin/env python3
"""Check a repository's files against the design model's grammar (version 3)."""

import argparse
import datetime
import json
import os
import re
import subprocess
import sys
from pathlib import Path

CONTRACT = """\
contract:
  - It reads, under --root (default: the current directory):
    spec/index.md, whose frontmatter `id` names the bounded-context,
    written bounded-context/<context path>, the path being
    <owner>/<product>/<context name>, and whose `## Glossary` bullets,
    each written `- **<term>**: <definition>. Not: <word>, <word>.` (the
    `Not:` part optional, split on `. Not:` only), are the context's terms,
    term/<context path>/<term lowercased, spaces as hyphens>; a bullet of
    that section in any other form is a file problem;
    spec/capabilities/*.md, each a capability with frontmatter (id, narrator,
    group, rests_on, retired) and a `## Behaviour` section; a `formulated_as`
    key is a file problem;
    features/**/*.feature, the containers of acceptance-scenarios, a
    capability <name>'s being features/<name>.feature; any other feature file
    is a file problem;
    spec/decisions/*.md but index.md, one design-decision each (frontmatter
    id, summary, date, status, supersedes, revisit_when, revisit_signal);
    .shop/work/<initiative>/initiative.md and .shop/work/<initiative>/<part>.md;
    .shop/records/observations.md (one `## <id>` heading an observation) and
    any other Markdown under .shop/records/ whose frontmatter has an `id`.
    It reads no other layout: spec/decisions.md and a decisions/, work/ or
    records/ directory at the root are each a file problem naming
    scripts/migrate, which moves them.
  - Ids are type-first: a node's id is <kind>/<context path>/<name>, with
    the design model's kind name and <name> matching [a-z0-9]+(-[a-z0-9]+)*;
    an id in any other form is a file problem. A capability's id is
    capability/<context path>/<its file name>. A reference may be written in
    full, in short as <kind>/<name> (in this context), or as the bare <name>
    in a field that fixes the kind (rests_on, supersedes, argues, under,
    depends_on, and the capability of a requirement reference). The forms
    <context name>/<name>, decision/<name> and obs/<name> name nothing.
  - Each bullet of a capability's Behaviour section is a
    capability-requirement; `- [r<n>] ...` gives it the id <capability>#r<n>.
    A bullet with no [r<n>] is a requirement with no id.
    `retired: [r4, ...]` lists ids the capability used and retired.
    A reference is written <capability>#r<n>. In a
    list, <capability>#r<a>-r<b> stands for each id from a to b.
  - A scenario names its requirement by a tag @r<n> in the capability's own
    feature file, features/<name>.feature; its title is free. A scenario
    with no such tag names none.
    A scenario tagged @deprecated is no acceptance-scenario; one tagged @holding is a file problem.
  - facts prints the facts it read, one a line, in clingo's syntax, under
    grammar.md's relation names. A term gives node(T, "term"),
    term_of(T, <bounded-context>), avoid(T, <word>) for each word after its
    `Not:`, and glossary_entry(T, <bullet number>, <term lowercased>); each
    requirement (its line) and each acceptance-scenario (its title and its
    Given/When/Then/And/But steps, not its description, docstrings or
    Examples tables) gives mentions(X, <word>) for each term or avoided word it contains, as a
    whole word in any case, with a plural "s" allowed. It needs nothing
    beyond the standard library.
  - Every rule of model.lp has one plain label, label("<code>", "<label>"),
    written beside it. check prints `<code>  <label>  (<count>)` above each
    non-empty v_ relation's rows; `rules` prints every `<code>  <label>`,
    the v_ rules then the w_ rules, and exits 0; check --json adds "labels",
    {code: label} for the codes it prints.
  - check solves the facts with model.lp (beside this script) and prints every
    non-empty v_ relation, then the w_ relations with their counts, then the
    references that name nothing and the file problems (a missing id, a
    status not in a lifecycle, a block it cannot read). It exits 1 when any
    v_ relation is non-empty, any reference names nothing or any file has a
    problem, 0 otherwise. It needs the clingo package. When the
    interpreter that runs it lacks clingo, check runs again, once, under the
    first of $SHOPSYSTEM_MODEL_PYTHON, each python3 on PATH outside the
    active virtualenv's bin/, /usr/local/bin/python3 and /usr/bin/python3
    whose `-c "import clingo"` succeeds; when none does, it says so with the
    command that installs clingo and each interpreter it tried, and exits 2.
  - A capability-proposal or work-item may be `withdrawn`: no longer pursued,
    and closed (an extension proposed against grammar.md v3). v_d2 names an
    `abandoned` initiative with a part, at any depth, neither closed nor
    withdrawn; abandoning an initiative means withdrawing what is open under it.
  - decisions writes spec/decisions/index.md, the generated index of
    spec/decisions/, each row linked to its file, and nothing else; --check
    writes nothing and exits 1 when the file on disk is not what it would
    write.
  - why <capability>#r<n> prints the trace the model gives for a
    requirement: the requirement, each capability-proposal that adds or
    changes it, the part_of chain to its initiative, and the initiative's
    sources. It exits 1 when no proposal adds or changes the id, and 2 when
    the argument is not a requirement reference.
"""

LP = Path(__file__).resolve().with_name("model.lp")
RID = re.compile(r"^\[r(\d+)\]\s*")
REF = re.compile(r"^(?P<cap>[\w.-]+(?:/[\w.-]+)*)#r(?P<n>\d+)$")
STATUSES = {
    "initiative": {"proposed", "started", "done", "abandoned"},
    "capability-proposal": {"drafted", "approved", "merged", "formulated", "withdrawn"},   # withdrawn: EXTENSION (r58)
    "work-item": {"drafted", "researched", "planned", "ready", "claimed", "done", "green", "awaiting-ruling",
                  "withdrawn"},   # withdrawn: EXTENSION (r58)
}
SETTLED = {"merged", "formulated", "withdrawn"}     # a capability-proposal that may name a retired id (r5, r23)
PART_KINDS = {"job-proposal", "map-proposal", "vision-proposal", "job-thread", "capability-proposal",
              "cross-context-request", "map-escalation", "work-item"}
RECORD_KINDS = {"observation", "measurement", "review-finding", "decision-argument", "initiative-archive"}
KINDS = {"bounded-context", "capability", "design-decision", "acceptance-scenario", "term", "initiative",
         "capability-proposal", "job-proposal", "map-proposal", "vision-proposal", "job-thread",
         "cross-context-request", "map-escalation", "work-item", "observation", "measurement", "review-finding",
         "decision-argument", "initiative-archive", "job", "context-seam", "product-vision"}
NAME = r"[a-z0-9]+(?:-[a-z0-9]+)*"
CONTEXT_PATH = rf"{NAME}(?:\.{NAME})*/{NAME}/{NAME}"     # <owner>/<product>/<context name>; the owner may be a domain
NOT_PROSE = re.compile(r'`[^`]*`|"[^"]*"|(?<!\w)@[\w-]+')
ENTRY = re.compile(r"^\*\*(?P<term>[^*]+?)\*\*: (?P<rest>.+)$")    # a glossary bullet, after its "- "
DECISIONS = Path("spec") / "decisions"
WORK = Path(".shop") / "work"
RECORDS = Path(".shop") / "records"
OLD_LAYOUT = ("spec/decisions.md", "decisions/", "work/", "records/")    # what scripts/migrate moves (r61)
REEXEC = "SHOPSYSTEM_MODEL_REEXEC"      # set when check runs again under another interpreter (r56)


# ---------------------------------------------------------------- reading

def frontmatter(text):
    """The YAML subset the model's files use: scalars, [a, b] lists and '- x' block lists."""
    if not text.startswith("---\n"):
        return {}, text
    end = text.find("\n---", 4)
    if end < 0:
        return {}, text
    head, body = text[4:end], text[end + 4:].lstrip("\n")
    data, key, unread = {}, None, []
    for line in head.splitlines():
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        line = strip_comment(line)
        m = re.match(r"^\s*-\s+(.*)$", line)
        if m and key is not None and (data.get(key) is None or isinstance(data.get(key), list)):
            if not isinstance(data.get(key), list):
                data[key] = []
            data[key].append(scalar(m.group(1)))
            continue
        m = re.match(r"^([\w-]+):\s*(.*)$", line)
        if not m:
            continue
        key, value = m.group(1), m.group(2).strip()
        if value in (">", ">-", ">+", "|", "|-", "|+"):
            unread.append(key)
            data[key] = None
        elif value.startswith("[") and value.endswith("]"):
            inner = value[1:-1].strip()
            data[key] = [scalar(v) for v in split_list(inner)] if inner else []
        elif value == "":
            data[key] = None
        else:
            data[key] = scalar(value)
    if unread:
        data["__unread__"] = unread
    return data, body


def strip_comment(line):
    """Drop a ' # comment' that is outside quotes."""
    quote = None
    for i, ch in enumerate(line):
        if quote:
            if ch == quote:
                quote = None
        elif ch in "'\"":
            quote = ch
        elif ch == "#" and i > 0 and line[i - 1] in " \t":
            return line[:i].rstrip()
    return line


def split_list(inner):
    out, cur, quote = [], "", None
    for ch in inner:
        if quote:
            cur += ch
            if ch == quote:
                quote = None
        elif ch in "'\"":
            quote, cur = ch, cur + ch
        elif ch == ",":
            out.append(cur.strip())
            cur = ""
        else:
            cur += ch
    if cur.strip():
        out.append(cur.strip())
    return out


def scalar(v):
    v = v.strip()
    if len(v) >= 2 and v[0] == v[-1] and v[0] in "'\"":
        return v[1:-1]
    return v


def as_list(v):
    if v is None:
        return []
    return v if isinstance(v, list) else [v]


def expand(refs):
    """<capability>#r<a>-r<b> (or an en dash) stands for every id from a to b."""
    out = []
    for ref in refs:
        m = re.fullmatch(r"(.+)#r(\d+)\s*[-–]\s*r?(\d+)", str(ref).strip())
        if m and int(m.group(2)) <= int(m.group(3)):
            out += [f"{m.group(1)}#r{n}" for n in range(int(m.group(2)), int(m.group(3)) + 1)]
        else:
            out.append(ref)
    return out


def section(body, title):
    """The lines of a `## <title>` section, up to the next `## `."""
    out, inside = [], False
    for line in body.splitlines():
        if line.startswith("## "):
            inside = line[3:].strip().lower() == title.lower()
            continue
        if inside:
            out.append(line)
    return out


def bullets(lines):
    """Top-level '- ' bullets, with their continuation lines joined."""
    out = []
    for line in lines:
        if line.startswith(("- ", "* ")):
            out.append(line[2:].strip())
        elif out and line.startswith("  ") and line.strip():
            out[-1] += " " + line.strip()
    return out


TABLE_ID = re.compile(r"^\[r\d+\]$")


def behaviour_items(lines):
    """(text, lead) of each requirement of a Behaviour section: a top-level '- ' bullet, its continuation lines joined,
    or a table row whose first cell is `[r<n>]` (a row whose first cell is `r<n>` without brackets is a line with no
    id), its other cells joined by ' | '. `lead` is the sentence just before the table: a bullet with no id that ends
    in ':', or a paragraph; None when something else (a heading, a requirement, another table) comes between.
    A table's header row and separator, a '###' heading and a lead sentence are no requirements."""
    items, lead, open_bullet, paragraph, in_table = [], None, False, False, False
    for line in lines:
        stripped = line.strip()
        if stripped.startswith("|"):
            open_bullet = paragraph = False
            in_table = True
            cells = [c.strip() for c in stripped.strip("|").split("|")]
            if cells and (TABLE_ID.match(cells[0]) or re.fullmatch(r"r\d+", cells[0])):
                items.append([cells[0] + " " + " | ".join(cells[1:]), lead])
            elif items and items[-1][1] is None and not RID.match(items[-1][0]) and items[-1][0].endswith(":"):
                lead = items.pop()[0]       # a bullet with no id that ends in ':' above a table leads it
            continue
        if in_table and stripped:
            lead, in_table = None, False
        if line.startswith(("- ", "* ")):
            items.append([stripped[2:].strip(), None])
            lead = None if RID.match(items[-1][0]) else items[-1][0]
            open_bullet, paragraph = True, False
        elif open_bullet and line.startswith("  ") and stripped:
            items[-1][0] += " " + stripped
            lead = None if RID.match(items[-1][0]) else items[-1][0]
        elif stripped.startswith("#"):
            lead, open_bullet, paragraph = None, False, False
        elif stripped and not line.startswith(" "):
            lead = lead + " " + stripped if paragraph else stripped
            open_bullet, paragraph = False, True
        elif not stripped:
            paragraph = False
    return [tuple(i) for i in items]


def scenarios(text):
    """(title, tags, steps) for each Scenario or Scenario Outline of a feature file."""
    out, pending, in_doc, feature_tags, steps = [], [], None, [], None
    for raw in text.splitlines():
        line = raw.strip()
        if in_doc:
            if line.startswith(in_doc):
                in_doc = None
            continue
        if line.startswith('"""') or line.startswith("```"):
            in_doc = line[:3]
            continue
        if line.startswith("@"):
            pending += [t for t in line.split() if t.startswith("@")]
            continue
        m = re.match(r"^(?:Scenario(?: Outline| Template)?|Example):\s*(.*)$", line)
        if m:
            steps = []
            out.append((m.group(1).strip(), feature_tags + pending, steps))
            pending = []
        elif line.startswith("Feature:"):
            feature_tags, pending, steps = pending, [], None
        elif line.startswith(("Background:", "Examples:", "Scenarios:", "Rule:")):
            pending, steps = [], None
        elif steps is not None and re.match(r"^(?:Given|When|Then|And|But|\*)\s", line):
            steps.append(line)
    return out


def glossary_entry(bullet):
    """(term, [avoided words]) of a bullet written **<term>**: <definition>. Not: <word>, <word>.; None otherwise."""
    m = ENTRY.match(bullet)
    if not m or not m.group("rest").endswith("."):
        return None
    definition, _, avoided = m.group("rest").partition(". Not: ")
    words = [" ".join(w.split()).lower() for w in avoided[:-1].split(",")] if avoided else []
    if not definition.strip(" .") or not m.group("term").strip() or any(not w for w in words):
        return None
    return m.group("term").strip(), words


CLAUSE_RANK = {"Where": 1, "While": 2, "When": 3, "If": 3}
CLAUSE = re.compile(r"(Where|While|When|If)\b", re.IGNORECASE)


def ears(line):
    """(in a pattern, one shall and one sentence) of a Behaviour line, or of a table's lead sentence (r103, r104).

    The line is matched after removing `**` and the `[r<n>]` prefix, a code span or a double-quoted string standing
    for a word: `Where`, then `While`, then one `When` or `If ... then`, then the system and `shall` and the response.
    """
    if line is None:
        return False, False
    text = RID.sub("", line).replace("**", "")
    text = re.sub(r'`[^`]*`|"[^"]*"', "X", text).strip().rstrip(":")
    shalls = list(re.finditer(r"\bshall\b", text, re.IGNORECASE))
    plain = re.sub(r"\b(?:e\.g|i\.e|etc)\.", "X", text, flags=re.IGNORECASE)     # an abbreviation ends no sentence
    one = len(shalls) <= 1 and not re.search(r"[.!?](?=\s+\S)", plain)
    if not shalls:
        return False, one
    rest, rank = text[: shalls[0].start()].strip(), 0
    while True:
        m = CLAUSE.match(rest)
        if not m:
            break
        kw = m.group(1)
        if rank == 0 and kw not in CLAUSE_RANK:         # the line opens with its keyword capitalised; later ones may not
            return False, one
        kw = kw.capitalize()
        if CLAUSE_RANK[kw] <= rank:
            return False, one
        rank = CLAUSE_RANK[kw]
        if kw == "If":
            m = re.match(r"if .+?, then (\S.*)$", rest, re.IGNORECASE)
            if m is None:
                return False, one
            rest = m.group(1)       # what follows `then` may be no further clause: the loop refuses it
            continue
        nxt = re.search(r", (?=(?:Where|While|When|If)\b)", rest, re.IGNORECASE)
        if nxt:
            rest = rest[nxt.end():]
            continue
        cut = rest.rfind(", ")
        if cut < 0:
            return False, one
        rest = rest[cut + 2:]
        break
    if rank == 0 and not rest.startswith(("The ", "X")):
        return False, one       # a ubiquitous line names its system: "The <system>" or a code span
    return bool(rest.strip()), one


def mention(word):
    """A whole-word, any-case match of <word>, a plural "s" allowed; a hyphen joins a word."""
    body = r"\s+".join(re.escape(w) for w in word.split())
    return re.compile(rf"(?<![\w-]){body}s?(?![\w-])", re.IGNORECASE)


def decision_files(root):
    """The decision files: every spec/decisions/*.md but the generated index.md (r19)."""
    return [p for p in sorted((Path(root) / DECISIONS).glob("*.md")) if p.name != "index.md"]


# ---------------------------------------------------------------- facts

class Model:
    def __init__(self, root, today=None):
        self.root = Path(root)
        self.today = today or datetime.date.today()
        self.facts = []
        self.nodes = {}
        self.dangling = []
        self.problems = []
        self.context = None     # bounded-context/<path>
        self.path = None        # <owner>/<product>/<context name>
        self.caps = {}          # capability id -> {"name", "reqs": {n: node id}, "group"}
        self.proposals = {}     # part id -> frontmatter
        self.parents = {}       # part id -> part_of
        self.sources = {}       # initiative id -> [record ids]
        self.req_text = {}
        self.sc_text = {}       # acceptance-scenario id -> its title and steps
        self.retired = set()    # (capability id, n)
        self.words = set()      # each term and avoided word, lowercased

    def fact(self, name, *args):
        self.facts.append((name, args))

    def node(self, ident, kind):
        if ident in self.nodes and self.nodes[ident] != kind:
            self.problems.append(f"{ident} is both a {self.nodes[ident]} and a {kind}")
        self.nodes[ident] = kind
        self.fact("node", ident, kind)

    def rel(self, path):
        try:
            return str(path.relative_to(self.root))
        except ValueError:
            return str(path)

    def qualify(self, ref, kind=None):
        """<kind>/<path>/<name> as is; <kind>/<name> in this context; <name> where the field fixes the kind."""
        ref = str(ref).strip()
        if not self.path:
            return ref
        head, slash, rest = ref.partition("/")
        if slash and head in KINDS:
            if rest.startswith(self.path + "/") or (head == "bounded-context" and rest == self.path):
                return ref
            if re.fullmatch(NAME, rest):
                return f"{head}/{self.path}/{rest}"
            return ref      # another context's full id, or malformed: want() or resolve_req() reports it
        if kind and re.fullmatch(NAME, ref):
            return f"{kind}/{self.path}/{ref}"
        return ref

    def check_id(self, ident, kind, where):
        """A node's id is <kind>/<context path>/<name>, with its own kind."""
        prefix = f"{kind}/{self.path}/"
        if self.path and not (str(ident).startswith(prefix) and re.fullmatch(NAME, str(ident)[len(prefix):])):
            self.problems.append(f"{where}: id {ident!r} is not {prefix}<name>")

    def resolve_req(self, ref, where):
        m = REF.match(str(ref).strip())
        cap = self.qualify(m.group("cap"), "capability") if m else None
        if not m or (self.path and not re.fullmatch(rf"capability/{re.escape(self.path)}/{NAME}", cap)):
            self.dangling.append(f"{where}: {ref!r} is not a requirement reference "
                                 "(<capability>#r<n>, or #r<a>-r<b> with a <= b, the capability written "
                                 "capability/<context path>/<name>, capability/<name> or <name>)")
            return None
        return f"{cap}#r{m.group('n')}"

    def read(self):
        self.read_layout()
        self.read_index()
        self.read_capabilities()
        self.read_features()
        self.read_decisions()
        self.read_records()
        self.read_work()
        self.check_refs()
        self.read_mentions()
        return self

    def read_layout(self):
        """Each path of the old layout under the root is a file problem (r61)."""
        for old in OLD_LAYOUT:
            path = self.root / old
            if path.is_dir() if old.endswith("/") else path.is_file():
                self.problems.append(f"{old}: the layout has no {old}; run scripts/migrate")

    def read_index(self):
        path = self.root / "spec" / "index.md"
        if not path.exists():
            self.problems.append("spec/index.md is missing: no bounded-context is named")
            return
        data, body = frontmatter(path.read_text())
        ident = data.get("id")
        if not ident:
            self.problems.append("spec/index.md has no frontmatter id naming the bounded-context")
            return
        m = re.fullmatch(rf"bounded-context/({CONTEXT_PATH})", str(ident))
        if not m:
            self.problems.append(f"spec/index.md: id {ident!r} is not bounded-context/<owner>/<product>/<context name>")
            return
        self.context, self.path = m.group(0), m.group(1)
        self.node(self.context, "bounded-context")
        self.read_glossary(body)

    def read_glossary(self, body):
        for n, bullet in enumerate(bullets(section(body, "Glossary")), 1):
            entry = glossary_entry(bullet)
            if entry is None:
                self.problems.append(f"spec/index.md: glossary bullet {n} is not "
                                     "'- **<term>**: <definition>. Not: <word>, <word>.' (Not: optional)")
                continue
            word, avoided = entry
            t = f"term/{self.path}/{'-'.join(word.lower().split())}"
            self.check_id(t, "term", "spec/index.md")
            self.node(t, "term")
            self.fact("term_of", t, self.context)
            self.fact("glossary_entry", t, n, " ".join(word.lower().split()))
            self.words.add(" ".join(word.lower().split()))
            for w in avoided:
                self.fact("avoid", t, w)
                self.words.add(w)

    def read_mentions(self):
        """mentions(X, W) for each requirement and scenario X and each term or avoided word W it contains."""
        found = [(w, mention(w)) for w in sorted(self.words)]
        for x, text in list(self.req_text.items()) + list(self.sc_text.items()):
            text = NOT_PROSE.sub(" ", text)        # code spans, double-quoted strings and @ tags are no mentions (r51)
            for w, pattern in found:
                if pattern.search(text):
                    self.fact("mentions", x, w)

    def read_capabilities(self):
        for path in sorted((self.root / "spec" / "capabilities").glob("*.md")):
            data, body = frontmatter(path.read_text())
            name = path.stem
            expected = f"capability/{self.path}/{name}" if self.path else None
            cap = data.get("id") or expected or name
            if expected and cap != expected:
                self.problems.append(f"{self.rel(path)}: id {cap!r} is not {expected!r}")
            elif expected:
                self.check_id(cap, "capability", self.rel(path))     # the file name must be a <name>
            self.node(cap, "capability")
            if self.context:
                self.fact("in", cap, self.context)
            if data.get("narrator"):
                self.fact("narrator", cap, data["narrator"])
            if data.get("group"):
                self.fact("group", cap, data["group"])
            for d in as_list(data.get("rests_on")):
                d = self.qualify(d, "design-decision")
                self.fact("rests_on", cap, d)
                self.want(d, "design-decision", self.rel(path))
            retired = set()
            for r in as_list(data.get("retired")):
                m = re.fullmatch(r"r?(\d+)", str(r))
                if m:
                    retired.add(int(m.group(1)))
                    self.retired.add((cap, int(m.group(1))))
                    self.fact("retired_id", cap, int(m.group(1)))
                else:
                    self.problems.append(f"{self.rel(path)}: retired {r!r} is not r<n>")
            self.unread(data, path)
            if "formulated_as" in data:
                self.problems.append(f"{self.rel(path)}: formulated_as is not read; the feature file is "
                                     f"features/{name}.feature")
            if not any(l.startswith("## ") and l[3:].strip().lower() == "behaviour" for l in body.splitlines()):
                self.problems.append(f"{self.rel(path)}: no '## Behaviour' section")
            entry = {"name": name, "reqs": {}, "group": data.get("group"), "path": path,
                     "feature": f"features/{name}.feature"}
            for i, (text, lead) in enumerate(behaviour_items(section(body, "Behaviour")), 1):
                m = RID.match(text)
                if m:
                    n = int(m.group(1))
                    q = f"{cap}#r{n}"
                    if n in entry["reqs"]:
                        q = f"{cap}#r{n}~{i}"   # a second bullet with the same id: its own node, so v15b sees both
                    self.fact("req_id", q, cap, n)
                    entry["reqs"].setdefault(n, q)
                    self.req_text[q] = text[m.end():]
                else:
                    q = f"{cap}#line{i}"
                    self.req_text[q] = text
                self.node(q, "capability-requirement")
                self.fact("has_req", cap, q)
                shaped, single = ears(lead if lead is not None else text)
                if not shaped:
                    self.fact("ears_other", q)
                if not single:
                    self.fact("ears_many", q)
            self.caps[cap] = entry

    def read_features(self):
        by_feature = {}
        for cap, entry in self.caps.items():
            by_feature[str(Path(entry["feature"]))] = cap
        for path in sorted((self.root / "features").rglob("*.feature")):
            key = self.rel(path)
            cap = by_feature.get(key)
            if cap is None:
                self.problems.append(f"{key}: not features/<name>.feature for a capability <name>")
            seen = set()
            for title, tags, steps in scenarios(path.read_text()):
                if "@holding" in tags:
                    self.problems.append(f"{key}: scenario {title!r} is tagged @holding; the tag is @deprecated")
                if "@deprecated" in tags:
                    continue        # a deprecated scenario formulates no line (design-decision/held-scenario-formulates-no-requirement)
                s = f"{key}:{title}"
                if s in seen:
                    self.problems.append(f"{key}: two scenarios are titled {title!r}")
                seen.add(s)
                self.node(s, "acceptance-scenario")
                self.sc_text[s] = "\n".join([title] + steps)
                for tag in tags:
                    m = re.fullmatch(r"@r(\d+)", tag)
                    if not m or cap is None:
                        continue
                    q = f"{cap}#r{m.group(1)}"
                    if q in self.nodes:
                        self.fact("has_sc", q, s)
                    else:
                        self.dangling.append(f"{key}: scenario {title!r} names {q}, which {cap} does not have")

    def read_decisions(self):
        for path in decision_files(self.root):
            data, body = frontmatter(path.read_text())
            self.unread(data, path)
            if not any(l.startswith("## ") and l[3:].strip() == "Decision" for l in body.splitlines()):
                self.problems.append(f"{self.rel(path)}: no '## Decision' section")
            d = data.get("id")
            if not d:
                self.problems.append(f"{self.rel(path)}: no frontmatter id")
                continue
            self.check_id(d, "design-decision", self.rel(path))
            self.node(d, "design-decision")
            if data.get("summary"):
                self.fact("summary", d, data["summary"])
            for old in as_list(data.get("supersedes")):
                old = self.qualify(old, "design-decision")
                self.fact("supersedes", d, old)
                self.want(old, "design-decision", self.rel(path))
            for s in as_list(data.get("source")):       # ids only; the free text is `by`, which is not read (r64)
                self.want(self.qualify(s), None, self.rel(path))
            if data.get("revisit_signal"):
                self.fact("revisit_signal", d, self.qualify(data["revisit_signal"]))   # "requests" stays as written

    def read_records(self):
        obs = self.root / RECORDS / "observations.md"
        if obs.exists():
            current = None
            for line in obs.read_text().splitlines():
                if line.startswith("## "):
                    current = line[3:].strip()
                    self.check_id(current, "observation", self.rel(obs))
                    self.node(current, "observation")
                elif current:
                    m = re.match(r"^about:\s*(.+)$", line.strip())
                    if m:
                        a = self.qualify(scalar(m.group(1)))
                        self.fact("about", current, a)
                        self.want(a, None, self.rel(obs))
        for path in sorted((self.root / RECORDS).rglob("*.md")):
            if path == obs:
                continue
            data, _ = frontmatter(path.read_text())
            if not data.get("id"):
                continue
            self.unread(data, path)
            kind = data.get("kind")
            if kind not in RECORD_KINDS:
                self.problems.append(f"{self.rel(path)}: kind {kind!r} is not a record kind")
                continue
            self.check_id(data["id"], kind, self.rel(path))
            self.node(data["id"], kind)
            for a in as_list(data.get("about")):
                a = self.qualify(a)
                self.fact("about", data["id"], a)
                self.want(a, None, self.rel(path))

    def read_work(self):
        for idir in sorted(p for p in (self.root / WORK).glob("*") if p.is_dir()):
            ipath = idir / "initiative.md"
            if not ipath.exists():
                self.problems.append(f"{self.rel(idir)}: no initiative.md")
                continue
            data, _ = frontmatter(ipath.read_text())
            i = data.get("id")
            if not i:
                self.problems.append(f"{self.rel(ipath)}: no frontmatter id")
                continue
            self.check_id(i, "initiative", self.rel(ipath))
            self.node(i, "initiative")
            self.status(i, "initiative", data.get("status"), ipath)
            if data.get("kind"):
                self.fact("ikind", i, data["kind"])
            if data.get("priority") is not None:
                try:
                    self.fact("priority", i, int(data["priority"]))
                except ValueError:
                    self.problems.append(f"{self.rel(ipath)}: priority {data['priority']!r} is not a number")
            self.sources[i] = [self.qualify(s) for s in as_list(data.get("source"))]
            for s in self.sources[i]:
                self.fact("source", i, s)
                self.want(s, None, self.rel(ipath))
            if data.get("date"):
                try:
                    days = (self.today - datetime.date.fromisoformat(str(data["date"]))).days
                    self.fact("age", i, days)
                except ValueError:
                    self.problems.append(f"{self.rel(ipath)}: date {data['date']!r} is not YYYY-MM-DD")
            for ppath in sorted(idir.glob("*.md")):
                if ppath.name != "initiative.md":
                    self.read_part(ppath)

    def read_part(self, path):
        data, _ = frontmatter(path.read_text())
        p, kind = data.get("id"), data.get("kind")
        where = self.rel(path)
        if not p or kind not in PART_KINDS:
            self.problems.append(f"{where}: needs an id and a kind among {', '.join(sorted(PART_KINDS))}")
            return
        self.check_id(p, kind, where)
        self.node(p, kind)
        self.status(p, kind, data.get("status"), path)
        self.unread(data, path)
        if data.get("part_of"):
            parent = self.qualify(data["part_of"])
            self.fact("part_of", p, parent)
            self.parents[p] = parent
            self.want(parent, None, where)
        for a in as_list(data.get("argues")):
            a = self.qualify(a, "capability")
            self.fact("argues", p, a)
            self.want(a, None, where)
        if kind == "capability-proposal":
            self.proposals[p] = data
            for rel in ("adds", "changes", "removes"):
                for ref in expand(as_list(data.get(rel))):
                    if str(ref).strip().startswith("term/"):     # a glossary term, not a requirement (r66)
                        head, _, name = str(ref).strip().rpartition("/")
                        t = self.qualify(f"{head}/{name.lower()}")      # r48: a term's id is lowercased
                        if self.nodes.get(t) != "term" and not (rel == "removes" and data.get("status") in ("merged", "formulated")):
                            self.dangling.append(f"{where}: {rel} {t}, which the glossary does not have")
                        continue
                    q = self.resolve_req(ref, where)
                    if not q:
                        continue
                    self.fact(rel, p, q)
                    if q in self.nodes:
                        continue
                    cap, n = q.rsplit("#r", 1)
                    if (cap, int(n)) in self.retired and data.get("status") in SETTLED:
                        continue                                # a merged, formulated or withdrawn proposal may name it (r5, r23)
                    if rel == "adds" and (cap, int(n)) in self.retired:
                        self.fact("req_id", q, cap, int(n))   # grammar.md's refusal table: v15c
                    elif rel != "changes":                     # changes: v15e reports it
                        self.dangling.append(f"{where}: {rel} {q}, which no capability has")
        if kind == "work-item":
            if data.get("wkind"):
                self.fact("wkind", p, data["wkind"])
            if data.get("under"):
                c = self.qualify(data["under"], "capability")
                self.fact("under", p, c)
                self.want(c, "capability", where)
            if data.get("for"):
                f = self.qualify(data["for"])
                self.fact("for", p, f)
                self.want(f, "work-item", where)
            if data.get("check"):
                self.fact("check", p, data["check"])
            for ref in expand(as_list(data.get("accepts"))):
                q = self.resolve_req(ref, where)
                if not q:
                    continue
                found = [args[1] for name, args in self.facts if name == "has_sc" and args[0] == q]
                for s in found:
                    self.fact("accepts", p, s)
                if not found:
                    self.problems.append(f"{where}: accepts {q}, which no scenario names yet")
            for b in as_list(data.get("blocked_by")):
                b = self.qualify(b)
                self.fact("blocked_by", p, b)
                self.want(b, "work-item", where)
            for d in as_list(data.get("depends_on")):
                d = self.qualify(d, "capability")
                self.fact("wi_depends", p, d)
                self.want(d, "capability", where)
            for f in as_list(data.get("fileset")):
                self.fact("fileset", p, f)

    def status(self, ident, kind, value, path):
        if value is None:
            self.problems.append(f"{self.rel(path)}: no status")
            return
        allowed = STATUSES.get(kind)
        if allowed and value not in allowed:
            self.problems.append(f"{self.rel(path)}: status {value!r} is not one of {', '.join(sorted(allowed))}")
        self.fact("status", ident, value)

    def want(self, ident, kind, where):
        self._wanted = getattr(self, "_wanted", [])
        self._wanted.append((ident, kind, where))

    def check_refs(self):
        for ident, kind, where in getattr(self, "_wanted", []):
            if kind is None and ident not in self.nodes:
                self.dangling.append(f"{where}: {ident} names nothing in this repository")
            elif kind is not None and self.nodes.get(ident) != kind:
                self.dangling.append(f"{where}: {ident} is not a {kind} in this repository")

    def unread(self, data, path):
        for key in data.get("__unread__", []):
            self.problems.append(f"{self.rel(path)}: {key} uses a folded or literal block, which is not read; write it on one line")

    def asp(self):
        def term(a):
            if isinstance(a, int):
                return str(a)
            return '"' + str(a).replace("\\", "\\\\").replace('"', '\\"') + '"'
        return "\n".join(f"{n}({', '.join(term(a) for a in args)})." for n, args in self.facts)


# ---------------------------------------------------------------- commands

def solve(model=None):
    """The shown relations of model.lp over a model's facts (none when model is None), as (relations, labels):
    the relations sorted, the labels as {code: label} apart from them."""
    import clingo
    ctl = clingo.Control(["--warn=none"])
    ctl.add("base", [], LP.read_text() + "\n" + (model.asp() if model else ""))
    ctl.ground([("base", [])])
    atoms = []
    ctl.solve(on_model=lambda m: atoms.extend(m.symbols(shown=True)))
    out = []
    for a in atoms:
        args = [x.string if x.type == clingo.SymbolType.String else
                x.number if x.type == clingo.SymbolType.Number else str(x) for x in a.arguments]
        out.append((a.name, args))
    labels = {args[0]: args[1] for name, args in out if name == "label"}
    out = [t for t in out if t[0] != "label"]
    return sorted(out, key=lambda t: (t[0], [str(x) for x in t[1]])), labels


def rule_order(labels):
    """The codes in the order model.lp gives their labels, which puts the violations before the warnings."""
    text = LP.read_text()
    return sorted(labels, key=lambda code: text.index(f'label("{code}",'))


def cmd_facts(args):
    print(Model(args.root).read().asp())
    return 0


def interpreters():
    """The interpreters check tries for clingo, in order (r55)."""
    out = []
    if os.environ.get("SHOPSYSTEM_MODEL_PYTHON"):
        out.append(os.environ["SHOPSYSTEM_MODEL_PYTHON"])
    venvs = {(Path(v) / "bin").resolve() for v in (os.environ.get("VIRTUAL_ENV"),
                                                    sys.prefix if sys.prefix != sys.base_prefix else None) if v}
    for d in os.environ.get("PATH", "").split(os.pathsep):
        here = Path(d or ".").resolve()     # an empty entry is the current directory, named in full
        p = here / "python3"
        if p.is_file() and os.access(p, os.X_OK) and here not in venvs:
            out.append(str(p))
    out += ["/usr/local/bin/python3", "/usr/bin/python3"]
    return list(dict.fromkeys(out))


def has_clingo(python):
    try:
        return subprocess.run([python, "-c", "import clingo"], capture_output=True, timeout=60).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def run_again_with_clingo():
    """Run check again under the first interpreter that has clingo (r55); the interpreters tried when none has it."""
    tried = []
    for python in interpreters():
        tried.append(python)
        if has_clingo(python):
            sys.stdout.flush()
            try:
                os.execvpe(python, [python, str(Path(__file__).resolve()), *sys.argv[1:]], {**os.environ, REEXEC: "1"})
            except OSError:
                continue
    return tried


def cmd_check(args):
    return needing_clingo("check", lambda: check(args))


def needing_clingo(command, run):
    """Run a command that solves with model.lp; without clingo it runs again under an interpreter that has it (r55)."""
    try:
        import clingo  # noqa: F401
    except ImportError:
        if os.environ.get(REEXEC):      # this is the run again (r56): it does not search a second time
            why = f"it ran again under {sys.executable}, which also failed to import clingo"
        else:
            why = "no interpreter it tried has it: " + ", ".join(run_again_with_clingo())
        print(f"{command} needs the clingo package, which this interpreter lacks; {why}.\n"
              f"  install: {sys.executable} -m pip install clingo\n"
              "  without it: `model facts` prints the facts for any Datalog or ASP engine.")
        return 2
    return run()


def cmd_rules(args):
    return needing_clingo("rules", lambda: rules())


def rules():
    """Every rule's code and plain label, one a line, the violations first and then the warnings (r65)."""
    labels = solve()[1]
    for code in rule_order(labels):
        print(f"{code}  {labels[code]}")
    return 0


def check(args):
    model = Model(args.root).read()
    found, labels = solve(model)
    violations = [f for f in found if f[0].startswith("v")]
    warnings = [f for f in found if f[0].startswith("w_")]
    if args.json:
        printed = sorted({name for name, _ in violations + warnings}, key=rule_order(labels).index)
        print(json.dumps({"violations": violations, "warnings": warnings,
                          "unresolved": model.dangling, "problems": model.problems,
                          "labels": {code: labels[code] for code in printed}}, indent=1))
    else:
        by = {}
        for name, a in violations:
            by.setdefault(name, []).append(a)
        for name in sorted(by):
            print(f"{name}  {labels[name]}  ({len(by[name])})")
            for a in by[name][: args.limit]:
                print("    " + ", ".join(str(x) for x in a))
            if len(by[name]) > args.limit:
                print(f"    ... and {len(by[name]) - args.limit} more")
        counts = {}
        for name, _ in warnings:
            counts[name] = counts.get(name, 0) + 1
        for name in sorted(counts):
            print(f"warning {name}  {labels[name]}  ({counts[name]})")
        for d in model.dangling:
            print(f"unresolved: {d}")
        for p in model.problems:
            print(f"file: {p}")
        print(f"{len(violations)} violations, {len(warnings)} warnings, "
              f"{len(model.dangling)} unresolved references, {len(model.problems)} file problems")
    return 1 if violations or model.dangling or model.problems else 0


def render_decisions(root):
    index = Model(root)
    index.read_index()
    rows = []
    for path in decision_files(root):
        data, _ = frontmatter(path.read_text())
        if not data.get("id"):
            continue
        rows.append((path.name, data))
    lines = ["# Decisions", "",
             "Generated by `scripts/model decisions` from `spec/decisions/`; never edited by hand.",
             "Each decision's `## Decision` section is standing; the rest of its file is record.", "",
             "| decision | summary | status | supersedes | revisit when |",
             "|---|---|---|---|---|"]
    for name, d in rows:
        sup = ", ".join(index.qualify(s, "design-decision") for s in as_list(d.get("supersedes"))) or ""
        rev = d.get("revisit_when") or ""
        cell = lambda s: str(s).replace("|", "\\|")
        lines.append(f"| [{d['id']}]({name}) | {cell(d.get('summary', ''))} | "
                     f"{d.get('status', '')} | {cell(sup)} | {cell(rev)} |")
    return "\n".join(lines) + "\n"


def cmd_decisions(args):
    text = render_decisions(args.root)
    target = Path(args.root) / DECISIONS / "index.md"
    if args.check:
        current = target.read_text() if target.exists() else ""
        if current != text:
            print("spec/decisions/index.md is not what `model decisions` writes: run it")
            return 1
        print("spec/decisions/index.md is current")
        return 0
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(text)
    print(f"wrote {target.relative_to(args.root) if not os.path.isabs(args.root) else target}")
    return 0


def cmd_why(args):
    model = Model(args.root).read()
    q = model.resolve_req(args.ref, "why")
    if not q:
        print("\n".join(model.dangling))
        return 2
    text = model.req_text.get(q)
    print(f"{q}: {text}" if text is not None else f"{q}: no capability has this requirement now")
    found = False
    for p, data in sorted(model.proposals.items(), key=lambda t: str(t[1].get("date", ""))):
        rels = [rel for rel in ("adds", "changes", "removes")
                if q in [model.resolve_req(r, p) for r in expand(as_list(data.get(rel)))]]
        if not rels:
            continue
        found = found or bool(set(rels) & {"adds", "changes"})
        print(f"  {'/'.join(rels)} by capability-proposal {p} ({data.get('status')}, {data.get('date', 'undated')})")
        chain, cur, seen = [], model.parents.get(p), set()
        while cur and cur not in seen:
            seen.add(cur)
            chain.append(cur)
            cur = model.parents.get(cur)
        for c in chain:
            kind = model.nodes.get(c, "?")
            print(f"    part_of {kind} {c}")
            if kind == "initiative":
                for s in model.sources.get(c, []):
                    print(f"      source {model.nodes.get(s, '?')} {s}")
    if not found:
        print("  no capability-proposal adds or changes it")
        return 1
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser(prog="model", description=__doc__, epilog=CONTRACT,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--root", default=".")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("rules", help="print every rule's code and plain label, the violations first")
    sub.add_parser("facts", help="print the facts read from the repository")
    c = sub.add_parser("check", help="solve the facts against model.lp and report")
    c.add_argument("--json", action="store_true")
    c.add_argument("--limit", type=int, default=10, help="rows shown per relation")
    d = sub.add_parser("decisions", help="write spec/decisions/index.md from spec/decisions/")
    d.add_argument("--check", action="store_true")
    w = sub.add_parser("why", help="trace a requirement to its initiative's sources")
    w.add_argument("ref")
    args = ap.parse_args(argv)
    return {"facts": cmd_facts, "check": cmd_check, "rules": cmd_rules, "decisions": cmd_decisions, "why": cmd_why}[args.cmd](args)


if __name__ == "__main__":
    sys.exit(main())
