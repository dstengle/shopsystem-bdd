#!/usr/bin/env python3
"""Read Gherkin feature files without the test runner, and generate them from codified capabilities."""
import argparse
import importlib.util
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import features_generate
import features_vocab
import features_vocab4
import spec_grammar
import spec_language
import spec_read
import spec_unbuilt
from features_bindings import cmd_bindings
from features_gherkin import load
from features_report import cmd_count, cmd_deprecated, cmd_list
from model_parse import frontmatter
from shop_refused import Refused

CONTRACT = """\
contract:
  - It reads every *.feature under --dir (default: features), recursively,
    parsing Gherkin directly. Text inside a docstring (\"\"\" or three
    backticks) is never a keyword or a tag. A Rule: block is refused, not
    guessed at.
  - A scenario's block is its tag lines, its Scenario: line and everything up
    to the next scenario's tag lines. Feature tags apply to every scenario in
    the file; tags above an Examples: apply to that table's rows. A Scenario
    Outline counts once per Examples row, header excluded, as pytest-bdd
    collects it.
  - Feature files are written by `generate`, never edited by hand or by
    this script: tag, move, deprecate, retire, rebind and verify-moved are
    gone. A deprecated scenario (tagged @deprecated, with a description line
    'Deprecated for: <title>' or 'Deprecated for: removal') is only read.
    deprecated lists each deprecated scenario with what it is deprecated for
    and, for a replacement, the file and @r<n> tag of the scenario with that
    title; its line says when there is no Deprecated for: line, no scenario
    has the title, or the replacement has no @r<n> tag.
  - bindings reads every *.py under --tests (default: tests) and reports each
    scenario(<feature>, "<title>") call whose title no feature file has: a
    binding like that stops its whole module collecting. Only a title
    written as a plain string in the call is read; a feature given as a name
    is looked up among the module's own assignments.
  - bindings also reads scenarios(<path>, ...) calls: each path names a
    feature file by base name, or a directory (resolved against --dir) whose
    feature files it binds. With --unbound [<feature file>...] it then lists,
    for the named files (default every file under --dir), each scenario no
    call binds as '<feature path>: <title> | bound by no test', and each bound
    by several calls as '<feature path>: <title> | bound by <module>:<line>,
    ...'; exit 1 when any. A Scenario Outline is one scenario, by title.

  - generate [<capability>...] writes features/<capability>.feature from each
    named codified service capability (all of them when none is named), one
    scenario a requirement group, deterministically: the header
    '# generated from spec/capabilities/<c>.md by features generate; do not
    edit', the group's given block, Givens, the When, one Then a requirement.
    A service capability that is not codified, named or not, exits 2 ('...
    is not codified: run `migrate upgrade`') and nothing is written; a
    requirement that does not parse exits 1 naming <capability>#r<n>. --check
    regenerates in memory and exits 1 naming each file that differs. A service
    capability whose every line is retired (no group, ids in `retired:`) has
    no feature file: generate
    removes it ('removed features/<c>.feature') and --check names it while it
    exists. --preview <file>
    prints the feature of a draft capability file and writes nothing.
  - vocab prints the step vocabulary: each (template, kind) pattern of the
    Steps grammar. vocab --check [--tests DIR] [<feature>...] imports DIR's
    world_*.py and *_handlers*.py and exits 1 naming each step of the
    generated feature files (all of them when none is named) that does not
    parse or has no handler, and each key two handlers claim. A scenario of a
    requirement its capability lists in `unbuilt:` needs no handler.

exit status: 0 success, 1 a check failed or a file was refused, 2 bad usage.
"""

def read(path):
    with open(path) as f:
        return f.read()


def cmd_generate(args):
    """`features generate`: write, check or preview the features of codified service capabilities (§13.4)."""
    root = args.root
    caps = os.path.join(root, "spec", "capabilities")
    out_dir = args.dir if os.path.isabs(args.dir) else os.path.join(root, args.dir)
    def service(path):
        return frontmatter(read(path))[0].get("group") == "service"
    def retired(path):
        cap = spec_read.capability(path)
        return not cap.groups and bool(cap.retired)
    try:
        if args.preview:
            sys.stdout.write(features_generate.generate(root, args.preview))
            return 0
        for name in args.names:
            path = os.path.join(caps, "%s.md" % name)
            if spec_read.codified(path) and not service(path):
                sys.stderr.write("features: %s is a guarantees capability: it has no scenarios\n" % name)
                return 2
        paths = [os.path.join(caps, "%s.md" % n) for n in args.names] or [
            os.path.join(caps, f) for f in sorted(os.listdir(caps)) if f.endswith(".md") and service(
                os.path.join(caps, f))]
        refused = features_generate.uncodified(root, paths)
        if refused:
            sys.stderr.write("features: %s\n" % refused)
            return 2
        # A service capability whose every line is retired (no group, ids in `retired:`) has no feature file
        # (plan 9, D4): None.
        texts = {os.path.basename(path)[:-3]: None if retired(path) else features_generate.generate(root, path)
                 for path in paths}
    except (features_generate.GenerateError, features_vocab.StepError, spec_grammar.Unlabelled) as err:
        sys.stderr.write("features: %s\n" % err)
        return 1
    differs = 0
    for name, text in texts.items():
        target = os.path.join(out_dir, "%s.feature" % name)
        shown = os.path.relpath(target, root)
        if text is None:
            if os.path.isfile(target) and args.check:
                print("differs: %s" % shown)
                differs = 1
            elif os.path.isfile(target):
                os.remove(target)
                print("removed %s" % shown)
        elif not args.check:
            os.makedirs(out_dir, exist_ok=True)
            with open(target, "w") as f:
                f.write(text)
            print("wrote %s" % shown)
        elif not os.path.isfile(target) or read(target) != text:
            print("differs: %s" % shown)
            differs = 1
    return differs


def registry():
    """The handler registry: the plugin's tests/scenarios/vocab.py, loaded once as `vocab`."""
    if "vocab" not in sys.modules:
        path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "tests", "scenarios", "vocab.py")
        spec = importlib.util.spec_from_file_location("vocab", path)
        sys.modules["vocab"] = module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
    return sys.modules["vocab"]


def steps_of(path):
    """(line number, keyword, text) of each step of a feature file; docstrings and tables skipped."""
    out, last, in_doc = [], None, False
    with open(path) as f:
        for n, line in enumerate(f.read().splitlines(), 1):
            word, _, rest = line.strip().partition(" ")
            if line.strip() in ('"""', "```"):
                in_doc = not in_doc
            elif not in_doc and word in ("Given", "When", "Then", "And", "But"):
                last = word.lower() if word in ("Given", "When", "Then") else last
                out.append((n, last, rest))
    return out


def cmd_vocab(args):
    """`features vocab [--check]`: the vocabulary, or the steps of generated features with no handler."""
    root = os.path.abspath(args.root)
    vocab = features_vocab.load(root)
    if not args.check:
        for row in features_vocab.rows(vocab):
            print("%s %s %s: %s" % (row.keyword, row.template, row.kind or "-", row.pattern))
        return 0
    handlers = registry()
    handlers.load_handlers(os.path.join(root, args.tests))
    problems = handlers.duplicates()
    directory = args.dir if os.path.isabs(args.dir) else os.path.join(root, args.dir)
    files = args.features or (sorted(os.path.join(directory, f) for f in os.listdir(directory)
                                     if f.endswith(".feature")) if os.path.isdir(directory) else [])
    for path in files:
        full = path if os.path.isabs(path) else os.path.join(root, path)
        with open(full) as f:
            generated = f.readline().startswith("# generated from ")
        if not generated:
            problems += ["%s: not generated by `features generate`" % path] if args.features else []
            continue
        unbuilt = spec_unbuilt.unbuilt_lines(full, root)
        four = spec_language.four(root, os.path.basename(full)[:-len(".feature")])     # a codified-2 capability's
        for n, keyword, text in steps_of(full):
            try:
                call = features_vocab4.step(root, keyword, text) if four else features_vocab.step(vocab, keyword, text)
            except features_vocab.StepError as err:
                problems.append("%s:%d: %s | %s" % (path, n, text, err))
                continue
            if n not in unbuilt and not handlers.lookup(call.template, call.term):
                problems.append("%s:%d: %s | no handler for %s %s" % (path, n, text, call.template, call.term))
    print("\n".join(problems) if problems else "every step has one handler")
    return 1 if problems else 0


def main():
    parser = argparse.ArgumentParser(
        prog="features", description=__doc__, epilog=CONTRACT,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--dir", default="features")
    sub = parser.add_subparsers(dest="command", required=True)
    count = sub.add_parser("count")
    count.add_argument("--by-tag", action="store_true", required=True)
    count.set_defaults(run=cmd_count)
    lst = sub.add_parser("list")
    group = lst.add_mutually_exclusive_group(required=True)
    group.add_argument("--tag")
    group.add_argument("--title")
    lst.add_argument("--json", action="store_true", help="print the matching scenarios as one JSON object")
    lst.set_defaults(run=cmd_list)
    dep = sub.add_parser("deprecated")
    dep.add_argument("--json", action="store_true", help="print each deprecated scenario as one JSON object")
    dep.set_defaults(run=cmd_deprecated)
    one = sub.add_parser("bindings")
    one.add_argument("--tests", default="tests")
    one.add_argument("--unbound", nargs="*", metavar="FEATURE",
                     help="also list each scenario (of these feature files, default all) bound by no call or by several")
    one.add_argument("--json", action="store_true", help="print the wrong and unbound bindings as one JSON object")
    one.set_defaults(run=cmd_bindings)
    gen = sub.add_parser("generate")
    gen.add_argument("names", nargs="*", metavar="CAPABILITY")
    gen.add_argument("--check", action="store_true")
    gen.add_argument("--preview", metavar="FILE")
    gen.add_argument("--root", default=".")
    gen.set_defaults(run=cmd_generate, raw=True)
    voc = sub.add_parser("vocab")
    voc.add_argument("features", nargs="*", metavar="FEATURE")
    voc.add_argument("--check", action="store_true")
    voc.add_argument("--tests", default="tests/scenarios")
    voc.add_argument("--root", default=".")
    voc.set_defaults(run=cmd_vocab, raw=True)
    args = parser.parse_args()
    if getattr(args, "raw", False):
        return args.run(args)
    try:
        return args.run(args, load(args.dir))
    except Refused as why:
        sys.stderr.write("features: %s\n" % why)
        return 1


if __name__ == "__main__":
    sys.exit(main())
