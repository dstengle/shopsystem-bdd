#!/usr/bin/env python3
"""Read and edit Gherkin feature files without the test runner."""
import argparse
import ast
import os
import re
import shutil
import sys

CONTRACT = """\
contract:
  - It reads every *.feature under --dir (default: features), recursively,
    parsing Gherkin directly. Text inside a docstring (\"\"\" or three
    backticks) is never a keyword or a tag. A Rule: block is refused, not
    guessed at.
  - A scenario's block is its tag lines, its Scenario: line and everything up
    to the next scenario's tag lines. Feature tags apply to every scenario in
    the file; tags above an Examples: apply to that table's rows. A Scenario
    Outline counts once per Examples row, header excluded, as pytest-bdd
    collects it.
  - tag finds the scenario by its exact title, refuses unless exactly one file
    has it (naming every file that does), and changes only its tag lines: the
    first tag of the new tag's kind (@slice-... or @r<n>) becomes the new one,
    any further tags of that kind go, other tags stay; with no tag of that
    kind, the new one joins the last tag line, or gets a tag line of its own
    at the scenario's indentation.
  - move (like hold and retire) finds the scenario by its exact title and
    refuses unless exactly one file has it, unless --file names the file.
  - move takes a scenario's block verbatim (trailing blank lines dropped) to
    the end of an existing file; with --inline-background, the source
    Background's steps are inserted before the scenario's first step at the
    scenario's step indentation; with --carry-feature-tags, the source file's
    feature tags the destination's feature tags lack go on a tag line of their
    own above the Scenario: line, at its indentation.
  - tag, hold, retire and move take --file <path>: the command works in that
    file only, whatever other files hold the title. It refuses, naming the
    file and changing no file, a file that does not hold the title, a file
    that holds it twice, and a file outside --dir. Without --file a title in
    several files is refused, as above.
  - verify-moved compares, by title, each scenario's effective tags, its
    description, and its Background steps followed by its own steps, all
    stripped of indentation, blanks and comments.

  - hold keeps a scenario that passes today in the suite when its line is
    re-worded or removed: it gains the tag @holding, " (held)" at the end of
    its title, and a description line 'Held for: <the title that replaces it>'
    or 'Held for: removal'. Nothing else in it changes, and the replacement
    need not be written yet. retire removes one
    scenario's block and refuses any scenario not tagged @holding. holding
    lists each held scenario with what it is held for and the slice tag its
    replacement carries.
  - bindings reads every *.py under --tests (default: tests) and reports each
    scenario(<feature>, "<title>") call whose title no feature file has: a
    binding like that stops its whole module collecting. rebind rewrites the
    title in those calls from one title to another, which must be a scenario
    in a feature file, and changes nothing else in the file. Only a title
    written as a plain string in the call is read; a feature given as a name
    is looked up among the module's own assignments. With --file <feature
    path>, rebind rewrites only the bindings whose feature argument names that
    file, both paths resolved (the argument against --dir); without it, every
    binding of the old title.
  - plugin writes slice_expectations.py, the pytest plugin that expects a
    test tagged to a slice the plan has as planned or blocked to fail, into
    a directory, and says how to register it.

exit status: 0 success, 1 a check failed or an edit was refused, 2 bad usage.
An edit that would leave its file invalid is refused and the file left as it was.
"""

STEP = re.compile(r"(Given|When|Then|And|But|\*)\s")
SCENARIO = re.compile(r"(Scenario Outline|Scenario Template|Scenario|Example):")
EXAMPLES = re.compile(r"(Examples|Scenarios):")
SLICE = re.compile(r"slice-\d+(\.\d+)?$")
REQ_TAG = re.compile(r"r\d+$")


FILE_HELP = "work in this file only, whatever other files hold the title"


class Refused(Exception):
    pass


class Scenario:
    def __init__(self, title, start, line, tag_lines, tags):
        self.title, self.start, self.line = title, start, line
        self.tag_lines, self.tags = tag_lines, tags
        self.end = None
        self.tables = []  # (tags, row count)


class Feature:
    def __init__(self, text):
        self.lines = text.split("\n")
        self.tags, self.scenarios = [], []
        self.background = None  # (first line, end)
        self.in_doc = [False] * len(self.lines)
        self.tag_line_set = set()
        self._parse()

    def _tags(self, indexes):
        found = []
        for i in indexes:
            self.tag_line_set.add(i)
            for word in self.lines[i].split():
                if word.startswith("#"):
                    break
                found.append(word.lstrip("@"))
        return found

    def _parse(self):
        delim, pending, table = None, [], None
        for i, line in enumerate(self.lines):
            s = line.strip()
            if delim:
                self.in_doc[i] = True
                if s.startswith(delim):
                    delim = None
                continue
            if s.startswith('"""') or s.startswith("```"):
                self.in_doc[i] = True
                if s.find(s[:3], 3) < 0:
                    delim = s[:3]
                continue
            if s.startswith("@"):
                pending.append(i)
            elif s.startswith("Feature:"):
                self.tags, pending = self._tags(pending), []
            elif s.startswith("Rule:"):
                raise Refused("line %d: Rule: blocks are not supported" % (i + 1))
            elif s.startswith("Background:"):
                self.background, pending = [i + 1, None], []
            elif SCENARIO.match(s):
                if self.scenarios:
                    self.scenarios[-1].end = pending[0] if pending else i
                elif self.background:
                    self.background[1] = pending[0] if pending else i
                title = s.split(":", 1)[1].strip()
                self.scenarios.append(Scenario(
                    title, pending[0] if pending else i, i, list(pending),
                    self._tags(pending)))
                pending, table = [], None
            elif EXAMPLES.match(s):
                table = (self._tags(pending), [0])
                self.scenarios[-1].tables.append(table)
                pending = []
            elif s.startswith("|") and table:
                table[1][0] += 1
            elif s and not s.startswith("#"):
                pending = []
        for sc in self.scenarios:
            if sc.end is None:
                sc.end = len(self.lines)
        if self.background and self.background[1] is None:
            self.background[1] = len(self.lines)

    def content(self, first, last):
        return [(i, self.lines[i].strip()) for i in range(first, last)
                if self.lines[i].strip() and i not in self.tag_line_set
                and (self.in_doc[i] or not self.lines[i].strip().startswith("#"))]

    def block(self, sc):
        end = sc.end
        while end > sc.start and not self.lines[end - 1].strip():
            end -= 1
        return end

    def rows(self, sc):
        """One tag set per collected test."""
        base = set(self.tags) | set(sc.tags)
        if not sc.tables:
            return [base]
        return [base | set(t) for t, n in sc.tables for _ in range(max(n[0] - 1, 0))]

    def effective_tags(self, sc):
        return set(self.tags) | set(sc.tags) | {x for t, _ in sc.tables for x in t}

    def first_step(self, sc):
        for i, s in self.content(sc.line + 1, sc.end):
            if not self.in_doc[i] and STEP.match(s):
                return i
        return None

    def description(self, sc):
        step = self.first_step(sc)
        return [s for _, s in self.content(sc.line + 1, step if step is not None else sc.end)]

    def steps(self, sc):
        step = self.first_step(sc)
        return [] if step is None else [s for _, s in self.content(step, sc.end)]

    def background_steps(self):
        if not self.background:
            return []
        return [s for _, s in self.content(*self.background)]


def load(directory):
    found = []
    for root, _, names in sorted(os.walk(directory)):
        for name in sorted(names):
            if name.endswith(".feature"):
                path = os.path.join(root, name)
                with open(path) as handle:
                    try:
                        found.append((path, Feature(handle.read())))
                    except Refused as why:
                        raise Refused("%s: %s" % (path, why))
    return found


def locate(files, title, args=None):
    only = getattr(args, "file", None)
    if only:
        return locate_in(files, title, only, args.dir)
    hits = [(p, f, sc) for p, f in files for sc in f.scenarios if sc.title == title]
    if not hits:
        raise Refused("no scenario titled %r" % title)
    if len(hits) > 1:
        raise Refused("title %r is in several scenarios: %s" % (
            title, ", ".join(sorted({p for p, _, _ in hits}))))
    return hits[0]


def locate_in(files, title, only, directory):
    """The one scenario titled `title` in the file `only`, a file under `directory`."""
    root = os.path.realpath(directory)
    target = os.path.realpath(only)
    if os.path.commonpath([root, target]) != root:
        raise Refused("%s is outside %s" % (only, directory))
    for path, f in files:
        if os.path.realpath(path) == target:
            hits = [sc for sc in f.scenarios if sc.title == title]
            if len(hits) > 1:
                raise Refused("%s holds the title %r twice" % (only, title))
            if hits:
                return path, f, hits[0]
            break
    raise Refused("%s does not hold the title %r" % (only, title))


def natural(tag):
    return [int(p) if p.isdigit() else p for p in re.split(r"(\d+)", tag)]


def cmd_count(args, files):
    counts, total = {}, 0
    for _, f in files:
        for sc in f.scenarios:
            for tags in f.rows(sc):
                total += 1
                for t in tags:
                    counts[t] = counts.get(t, 0) + 1
    for t in sorted(counts, key=natural):
        print(t, counts[t])
    print("total", total)
    return 0


def cmd_list(args, files):
    want = args.tag.lstrip("@") if args.tag else None
    hits = [(p, sc.title) for p, f in files for sc in f.scenarios
            if (want in f.effective_tags(sc) if want else args.title in sc.title)]
    for path, title in hits:
        print("%s: %s" % (path, title))
    return 0 if hits else 1


def write_checked(edits):
    """edits: {path: lines}. Validate every file parses, then write."""
    texts = {p: "\n".join(lines) for p, lines in edits.items()}
    for text in texts.values():
        Feature(text)
    for path, text in texts.items():
        with open(path, "w") as handle:
            handle.write(text)


def cmd_tag(args, files):
    if SLICE.match(args.slice):
        family = re.compile(r"@slice-")
    elif REQ_TAG.match(args.slice):
        family = re.compile(r"@r\d+$")
    else:
        sys.exit(usage_error("tag must look like slice-<n>, slice-<n>.<m> or r<n>"))
    path, f, sc = locate(files, args.title, args)
    lines = _retag(f, sc, args.slice, family)
    write_checked({path: lines})
    return 0


def _retag(f, sc, new_tag, family):
    lines = list(f.lines)
    new = "@" + new_tag
    placed = False
    for i in sc.tag_lines:
        indent = lines[i][:len(lines[i]) - len(lines[i].lstrip())]
        words = []
        for word in lines[i].split():
            if family.match(word):
                if not placed:
                    words.append(new)
                    placed = True
            else:
                words.append(word)
        lines[i] = indent + " ".join(words) if words else None
    if not placed:
        if sc.tag_lines:
            last = sc.tag_lines[-1]
            lines[last] = lines[last].rstrip() + " " + new
        else:
            text = lines[sc.line]
            lines[sc.line] = text[:len(text) - len(text.lstrip())] + new + "\n" + text
    return [x for x in lines if x is not None]


def cmd_move(args, files):
    path, f, sc = locate(files, args.title, args)
    dest = args.to
    if not os.path.isfile(dest):
        raise Refused("%s does not exist" % dest)
    if os.path.abspath(dest) == os.path.abspath(path):
        raise Refused("%s is the scenario's own file" % dest)
    end = f.block(sc)
    block = f.lines[sc.start:end]
    if args.inline_background:
        step = f.first_step(sc)
        if step is not None:
            line = f.lines[step]
            indent = line[:len(line) - len(line.lstrip())]
            at = step - sc.start
            block[at:at] = [indent + s for s in f.background_steps()]
    if args.carry_feature_tags:
        with open(dest) as handle:
            have = set(Feature(handle.read()).tags)
        carry = ["@" + t for t in f.tags if t not in have]
        if carry:
            text = block[sc.line - sc.start]
            block.insert(sc.line - sc.start, text[:len(text) - len(text.lstrip())] + " ".join(carry))
    source = f.lines[:sc.start] + f.lines[sc.end:]
    if sc.start > 0 and not f.lines[sc.start - 1].strip() and sc.end >= len(f.lines):
        while source and not source[-1].strip():
            source.pop()
        source.append("")
    with open(dest) as handle:
        target = handle.read().split("\n")
    while target and not target[-1].strip():
        target.pop()
    target += [""] + block + [""]
    write_checked({path: source, dest: target})
    return 0


def summarise(files):
    by_title = {}
    for _, f in files:
        for sc in f.scenarios:
            by_title.setdefault(sc.title, []).append((f, sc))
    return by_title


def cmd_verify(args, files):
    before = summarise(load(args.from_dir))
    after = summarise(files)
    out = []
    for label, side in (("before", before), ("after", after)):
        out += ["duplicate title %s: %s" % (label, t) for t in sorted(side) if len(side[t]) > 1]
    out += ["missing: " + t for t in sorted(set(before) - set(after))]
    out += ["added: " + t for t in sorted(set(after) - set(before))]
    matched = 0
    for title in sorted(set(before) & set(after)):
        if len(before[title]) > 1 or len(after[title]) > 1:
            continue
        (bf, bs), (af, a_s) = before[title][0], after[title][0]
        differs = []
        if bf.effective_tags(bs) != af.effective_tags(a_s):
            differs.append("tags")
        if bf.description(bs) != af.description(a_s):
            differs.append("description")
        if bf.background_steps() + bf.steps(bs) != af.background_steps() + af.steps(a_s):
            differs.append("steps")
        if differs:
            out.append("changed: %s (%s)" % (title, ", ".join(differs)))
        else:
            matched += 1
    if out:
        print("\n".join(out))
        return 1
    print("%d scenarios match" % matched)
    return 0


def indent_of(line):
    return line[:len(line) - len(line.lstrip())]


def cmd_hold(args, files):
    path, f, sc = locate(files, args.title, args)
    if "holding" in sc.tags:
        raise Refused("%r is held already" % args.title)
    lines = list(f.lines)
    text = lines[sc.line]
    lines[sc.line] = text.rstrip() + " (held)"
    after = next((lines[i] for i in range(sc.line + 1, sc.end) if lines[i].strip()), None)
    inner = indent_of(after) if after is not None else indent_of(text) + "  "
    lines.insert(sc.line + 1, inner + "Held for: " + ("removal" if args.removal else args.held_for))
    if sc.tag_lines:
        last = sc.tag_lines[-1]
        lines[last] = lines[last].rstrip() + " @holding"
    else:
        lines.insert(sc.line, indent_of(text) + "@holding")
    write_checked({path: lines})
    print("%s: %s (held)" % (path, args.title))
    return 0


def cmd_retire(args, files):
    path, f, sc = locate(files, args.title, args)
    if "holding" not in sc.tags:
        raise Refused("%r is not tagged @holding: only a held scenario is retired here" % args.title)
    lines = f.lines[:sc.start] + f.lines[sc.end:]
    if sc.end >= len(f.lines):
        while lines and not lines[-1].strip():
            lines.pop()
        lines.append("")
    write_checked({path: lines})
    return 0


def cmd_holding(args, files):
    titles = {sc.title: (f, sc) for _, f in files for sc in f.scenarios}
    held = [(p, f, sc) for p, f in files for sc in f.scenarios if "holding" in sc.tags]
    for path, f, sc in held:
        wanted = [s[len("Held for:"):].strip() for s in f.description(sc) if s.startswith("Held for:")]
        target = wanted[0] if wanted else None
        if target is None:
            where = "no 'Held for:' line"
        elif target == "removal":
            where = "the slice that removes the behaviour"
        elif target not in titles:
            where = "no scenario has that title"
        else:
            tf, ts = titles[target]
            tags = sorted((t for t in tf.effective_tags(ts) if SLICE.match(t)), key=natural)
            where = ", ".join(tags) if tags else "no slice yet"
        print("%s: %s | for: %s | %s" % (path, sc.title, target, where))
    if not held:
        print("none held")
    return 0


def binding_calls(tests):
    """Every scenario(<feature>, "<title>") call under tests: (path, source bytes, feature or None, title node)."""
    found = []
    for root, _, names in sorted(os.walk(tests)):
        for name in sorted(names):
            if not name.endswith(".py"):
                continue
            path = os.path.join(root, name)
            with open(path, "rb") as handle:
                source = handle.read()
            try:
                tree = ast.parse(source, path)
            except SyntaxError as why:
                raise Refused("%s does not parse: %s" % (path, why))
            names_ = {t.id: n.value.value for n in tree.body if isinstance(n, ast.Assign)
                      and isinstance(n.value, ast.Constant) and isinstance(n.value.value, str)
                      for t in n.targets if isinstance(t, ast.Name)}
            for node in ast.walk(tree):
                if not isinstance(node, ast.Call) or len(node.args) < 2:
                    continue
                called = node.func.id if isinstance(node.func, ast.Name) else getattr(node.func, "attr", None)
                title = node.args[1]
                if called != "scenario" or not isinstance(title, ast.Constant) or not isinstance(title.value, str):
                    continue
                first = node.args[0]
                feature = first.value if isinstance(first, ast.Constant) else names_.get(getattr(first, "id", None))
                found.append((path, source, feature if isinstance(feature, str) else None, title))
    return found


def cmd_bindings(args, files):
    titles = {}
    for path, f in files:
        for sc in f.scenarios:
            titles.setdefault(sc.title, set()).add(os.path.basename(path))
    lost = 0
    for path, _, feature, title in binding_calls(args.tests):
        have = titles.get(title.value, set())
        if not have or (feature and os.path.basename(feature) not in have):
            lost += 1
            print('%s:%d: no scenario titled "%s" in %s' % (path, title.lineno, title.value, feature or "any feature file"))
    if lost:
        return 1
    print("every binding names a scenario")
    return 0


def cmd_rebind(args, files):
    locate(files, args.new)
    edits = {}
    only = os.path.realpath(args.file) if args.file else None
    for path, source, feature, title in binding_calls(args.tests):
        if title.value != args.old:
            continue
        if only and (feature is None or os.path.realpath(os.path.join(args.dir, feature)) != only):
            continue
        if title.lineno != title.end_lineno:
            raise Refused("%s:%d: the title is written over several lines" % (path, title.lineno))
        edits.setdefault(path, (source, []))[1].append(title)
    literal = ('"%s"' % args.new.replace("\\", "\\\\").replace('"', '\\"')).encode()
    count = 0
    for path, (source, nodes) in edits.items():
        lines = source.split(b"\n")
        for node in sorted(nodes, key=lambda n: (n.lineno, n.col_offset), reverse=True):
            line = lines[node.lineno - 1]
            lines[node.lineno - 1] = line[:node.col_offset] + literal + line[node.end_col_offset:]
            count += 1
        with open(path, "wb") as handle:
            handle.write(b"\n".join(lines))
    print("%d binding%s rebound" % (count, "" if count == 1 else "s"))
    return 0


def cmd_plugin(args, files):
    source = os.path.join(os.path.dirname(os.path.abspath(__file__)), "slice_expectations.py")
    if not os.path.isdir(args.directory):
        raise Refused("%s is not a directory" % args.directory)
    target = os.path.join(args.directory, "slice_expectations.py")
    shutil.copyfile(source, target)
    package = os.path.isfile(os.path.join(args.directory, "__init__.py"))
    print("%s written. Register it with this line in the conftest.py beside it:\n"
          "  from %sslice_expectations import *  # noqa: F401,F403\n"
          "It is registered when `python -m pytest --help` lists the option --slice."
          % (target, "." if package else ""))
    return 0


def usage_error(message):
    sys.stderr.write("features: error: %s\n" % message)
    return 2


def main():
    parser = argparse.ArgumentParser(
        prog="features", description=__doc__, epilog=CONTRACT,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--dir", default="features")
    sub = parser.add_subparsers(dest="command", required=True)
    count = sub.add_parser("count")
    count.add_argument("--by-tag", action="store_true", required=True)
    count.set_defaults(run=cmd_count)
    lst = sub.add_parser("list")
    group = lst.add_mutually_exclusive_group(required=True)
    group.add_argument("--tag")
    group.add_argument("--title")
    lst.set_defaults(run=cmd_list)
    tag = sub.add_parser("tag")
    tag.add_argument("title")
    tag.add_argument("slice", help="slice-<n>, slice-<n>.<m> or r<n>")
    tag.add_argument("--file", help=FILE_HELP)
    tag.set_defaults(run=cmd_tag)
    move = sub.add_parser("move")
    move.add_argument("title")
    move.add_argument("--to", required=True)
    move.add_argument("--inline-background", action="store_true")
    move.add_argument("--carry-feature-tags", action="store_true")
    move.add_argument("--file", help=FILE_HELP)
    move.set_defaults(run=cmd_move)
    verify = sub.add_parser("verify-moved")
    verify.add_argument("--from", dest="from_dir", required=True)
    verify.set_defaults(run=cmd_verify)
    hold = sub.add_parser("hold")
    hold.add_argument("title")
    what = hold.add_mutually_exclusive_group(required=True)
    what.add_argument("--for", dest="held_for")
    what.add_argument("--for-removal", dest="removal", action="store_true")
    hold.add_argument("--file", help=FILE_HELP)
    hold.set_defaults(run=cmd_hold)
    retire = sub.add_parser("retire")
    retire.add_argument("title")
    retire.add_argument("--file", help=FILE_HELP)
    retire.set_defaults(run=cmd_retire)
    sub.add_parser("holding").set_defaults(run=cmd_holding)
    for name, run in (("bindings", cmd_bindings), ("rebind", cmd_rebind)):
        one = sub.add_parser(name)
        if name == "rebind":
            one.add_argument("old")
            one.add_argument("new")
            one.add_argument("--file", help="rewrite only the bindings whose feature argument names this feature file")
        one.add_argument("--tests", default="tests")
        one.set_defaults(run=run)
    plugin = sub.add_parser("plugin")
    plugin.add_argument("directory")
    plugin.set_defaults(run=cmd_plugin)
    args = parser.parse_args()
    try:
        return args.run(args, [] if args.command == "plugin" else load(args.dir))
    except Refused as why:
        sys.stderr.write("features: %s\n" % why)
        return 1


if __name__ == "__main__":
    sys.exit(main())
