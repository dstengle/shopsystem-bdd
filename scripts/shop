#!/usr/bin/env python3
"""`shop`, the plugin's one command (decision 0132): `shop <command> <args>` runs the plugin's command of that name with
the same arguments, its output and exit unchanged."""
import argparse
import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
COMMANDS = {
    "work": "the backlog, batches, requests, the person's words, decisions and records",
    "spec": "the codified spec: parsing, checks, the logic, the lexicon and the catalogues",
    "features": "the generated features: Gherkin reading, bindings and reports",
    "measure": "what a batch cost and the defects found after its merge",
    "migrate": "a bounded context founded, and upgraded between plugin releases",
    "tools": "a project's analysis tools, found, installed and used",
}


def parser():
    listing = "\n".join(f"  {name:<9} {gist}" for name, gist in COMMANDS.items())
    made = argparse.ArgumentParser(
        prog="shop", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=f"commands:\n{listing}\n\n'shop <command> --help' prints a command's own help.")
    made.add_argument("command", choices=list(COMMANDS), metavar="command", help="one of: " + ", ".join(COMMANDS))
    made.add_argument("args", nargs=argparse.REMAINDER, help="the command's own arguments")
    return made


def main(argv):
    if argv and argv[0] in COMMANDS:
        os.execv(sys.executable, [sys.executable, os.path.join(HERE, argv[0]), *argv[1:]])
    parser().parse_args(argv)
    parser().error("a command is due")


if __name__ == "__main__":
    main(sys.argv[1:])
