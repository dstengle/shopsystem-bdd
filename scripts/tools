#!/usr/bin/env python3
"""Find, install and use a project's analysis tools, in the project's own environment."""
import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import shop_refused
import tools_check
import tools_env
import tools_map
import tools_refs
import tools_size

CONTRACT = """\
contract:
  - The tools are looked for in the project's own interpreter: --python
    (before the command or after it), or
    .venv/bin/python, venv/bin/python or $VIRTUAL_ENV under the current
    directory, or failing those the interpreter running this script, which is
    said. Only Python projects are known: any other gets one line saying so
    and exit 1, and agents then search by text and say that they did.
  - probe prints one line a tool, '<tool> <version>' or '<tool> missing: <what
    it is for>', and the interpreter. --log prints the one line for a
    researcher's notes: 'Probe: tools -> ...'. After the interpreter it
    prints the grammar block: 'grammar:', then gf (with its path), pgf,
    clingo and gf-rgl (with its path), each '<tool> <version>' or '<tool>
    missing: <what the workflow cannot do without it>'. The grammar tools
    are those of the interpreter running this script, gf is $SHOPSYSTEM_GF,
    the install path, or a gf on PATH that says it is Grammatical Framework,
    and gf-rgl is the RGL built at its install path, its version the pinned
    release. --json prints one object: python, source, tools and grammar
    ({"gf": "3.12.0" or null, "pgf", "clingo", "gf-rgl": "20250812" or
    null}). Exit 1 when any is missing.
  - install runs '<interpreter> -m pip install <package>' for each missing
    tool (ruff at the version the plugin pins) and nothing else: it edits no
    dependency file. It refuses an
    interpreter that is not a virtualenv. For each tool still missing it
    prints the tool, what it is for, what the workflow does without it, and
    the command that failed with the end of its error. Then, every time, it
    installs the grammar tools: the pinned pgf and clingo wheels
    into the interpreter running this script (--user outside a virtualenv),
    and GF 3.12, downloaded, checked by sha256, unpacked with dpkg-deb into
    ${XDG_DATA_HOME:-~/.local/share}/shopsystem-bdd/gf-3.12 with a bin/gf
    wrapper, and the RGL (gf-rgl) at its pinned release 20250812: its
    sources downloaded and checked by sha256, or the source tree
    $SHOPSYSTEM_GF_RGL_SRC names, built in English with that gf into
    ${XDG_DATA_HOME:-~/.local/share}/shopsystem-bdd/gf-rgl-20250812, the
    library path GF is given. One line a grammar tool: 'gf 3.12 downloaded'
    or 'gf 3.12 already installed', '<wheel> <version> installed' or '...
    already installed', 'gf-rgl 20250812 built' or 'gf-rgl 20250812
    already installed'. Linux x86_64 only: elsewhere, or without dpkg-deb,
    it exits 1 naming $SHOPSYSTEM_GF, for a GF built by hand. Exit 1 when
    any is still missing.
  - map runs the suite once under coverage with a context per test and keeps
    the data in .shop/scratch/tools/coverage. It is its own command, never
    part of the fast suite; arguments after -- go to pytest. Every tests-of
    and untested answer is as old as the last map, and says the commit it was
    made at.
  - tests-of <file>[:<function or Class.method, or <line>-<line>>] prints the
    tests that executed it in the last map, one a line, or with --by-file a
    count for each test file, and how many of the map's tests that is. Code
    on the path of every call is executed by most of the suite: the map
    narrows a search only for code off that path. A test that ran and failed
    counts: the map knows what a test executed, not what it proved. When
    none did it says so and exits 0. untested <file>... prints each function
    no test executed. map, tests-of, untested and refs take --json: one JSON
    object on stdout in place of the lines.
  - refs <name> prints every reference to a function, class or name defined
    in the project, as path:line, with the count of production and test files
    (a test file is under a tests or test directory or named test_* or
    *_test.*). It reads the code as the interpreter would, so it finds a use
    through an import or an alias that a text search misses, and does not
    find a name built from a string.
  - check runs ruff, vulture and, where the project has contracts for it,
    import-linter, over the paths given or the Python files changed since
    --base, each under its own heading. A tool that is missing is named
    under its heading, not skipped in silence. Exit 1 when any reports or is
    missing.
  - size prints each tracked Python file (a .py name or a python shebang) of
    more than --limit lines (300 without it) as '<path> <lines>', counted as
    the working tree has them, tests included. Exit 1 when any is printed. It
    needs no interpreter and no tools, only git.

exit status: 0 success, 1 something is missing, refused or reported, 2 bad usage.
"""


def under(python, argv):
    """Run this script again under the project's interpreter, where the tools are.

    Paths are compared as given, not resolved: a virtualenv's python is a link to its base interpreter, but it
    reads its own packages. The marker stops a second re-run when the interpreter reports another path."""
    if os.path.abspath(python) != os.path.abspath(sys.executable) and os.environ.get("TOOLS_UNDER") != python:
        os.environ["TOOLS_UNDER"] = python
        os.execv(python, [python, os.path.abspath(__file__)] + argv)


def main():
    parser = argparse.ArgumentParser(prog="tools", description=__doc__, epilog=CONTRACT,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--python")
    sub = parser.add_subparsers(dest="command", required=True)
    given = argparse.ArgumentParser(add_help=False)   # --python after the command too: `tools probe --python <p>`
    given.add_argument("--python", default=argparse.SUPPRESS)
    probe = sub.add_parser("probe", parents=[given])
    probe.add_argument("--log", action="store_true")
    probe.add_argument("--json", action="store_true")
    probe.set_defaults(run=tools_env.cmd_probe)
    sub.add_parser("install", parents=[given]).set_defaults(run=tools_env.cmd_install)
    made = sub.add_parser("map", parents=[given])
    made.add_argument("pytest", nargs="*")
    made.add_argument("--json", action="store_true")
    made.set_defaults(run=tools_map.cmd_map)
    tests_of = sub.add_parser("tests-of", parents=[given])
    tests_of.add_argument("target")
    tests_of.add_argument("--by-file", action="store_true")
    tests_of.add_argument("--json", action="store_true")
    tests_of.set_defaults(run=tools_map.cmd_tests_of, under=True)
    untested = sub.add_parser("untested", parents=[given])
    untested.add_argument("files", nargs="+")
    untested.add_argument("--json", action="store_true")
    untested.set_defaults(run=tools_map.cmd_untested, under=True)
    refs = sub.add_parser("refs", parents=[given])
    refs.add_argument("name")
    refs.add_argument("--json", action="store_true")
    refs.set_defaults(run=tools_refs.cmd_refs, under=True)
    check = sub.add_parser("check", parents=[given])
    check.add_argument("paths", nargs="*")
    check.add_argument("--base")
    check.set_defaults(run=tools_check.cmd_check)
    size = sub.add_parser("size", parents=[given])
    size.add_argument("--limit", type=int, default=tools_size.DEFAULT_LIMIT)
    size.set_defaults(run=tools_size.cmd_size)
    args = parser.parse_args()
    try:
        if getattr(args, "under", False) or (args.command == "map" and args.json):  # counting a map's tests needs coverage
            under(tools_env.interpreter(args)[0], sys.argv[1:])
        return args.run(args)
    except shop_refused.Refused as why:
        sys.stderr.write("tools: %s\n" % why)
        return 1


if __name__ == "__main__":
    sys.exit(main())
