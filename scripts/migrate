#!/usr/bin/env python3
"""migrate: take a repository from the old system to the final layout, in one run, deciding nothing that needs judgment.

  migrate run --context <owner/product/context>
  migrate status [--hook]
  migrate upgrade
  migrate init --id <bounded context id> [--purpose <context purpose>]

It works on the top level of the git repository it is run in. Every change is computed first (moves, new texts,
removals), checked, and only then written; a write that fails part way puts the repository back at its commit. A
symbolic link is never read or written through. Moves are `git mv`; nothing is committed.
"""
import argparse
import sys
from pathlib import Path

from adapter_cli_respond import prepare, respond
from plumbing.migrate_layout import Plan, plan_ids, plan_moves
from plumbing.migrate_write import Failed, check_moves, top_level, uncommitted, write
from upgrades import migrate_init
from upgrades.migrate_ledger import plan_ledger
from upgrades.migrate_spec import (
    plan_capabilities,
    plan_holding,
    plan_index,
    plan_references,
)
from upgrades.migrate_upgrade import run as run_upgrade


def refuse(failures):
    print("migrate changed nothing; it could not make these changes:", file=sys.stderr)
    for failure in failures:
        print("  " + failure, file=sys.stderr)
    return 1


def cmd_run(args):
    root = top_level(Path.cwd())        # the repository's top level, wherever in it migrate is run (r1)
    if root is None:
        return refuse(["could not find a git repository at %s" % Path.cwd()])
    plan = Plan(root, args.context)
    changed = uncommitted(plan.root)
    plan.failures += ["could not start from a tree with an uncommitted change: %s" % path for path in changed]
    if any(not (root / path).exists() and not (root / path).is_symlink() for path in changed):
        return refuse(plan.failures)        # a tracked file that is gone cannot be read to plan the rest (r15)
    plan_moves(plan)
    plan_ledger(plan)
    plan_holding(plan)
    plan_index(plan)
    plan_capabilities(plan)
    plan_ids(plan)
    plan_references(plan)
    check_moves(plan)
    if plan.failures:
        return refuse(plan.failures)
    try:
        write(plan)
    except Failed as failed:
        return refuse(["could not make every change, and put the repository back as it was: %s" % failed])
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser(prog="migrate", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("run", help="make every mechanical change, or none")
    r.add_argument("--context", required=True, help="<owner/product/context>")
    s = sub.add_parser("status", help="print the plugin versions and each pending upgrade step")
    s.add_argument("--hook", action="store_true", help="print what a session is told at its start, and exit 0")
    sub.add_parser("upgrade", help="apply each pending upgrade step and commit it all")
    i = sub.add_parser("init", help="found a new bounded context here: write its spec/, .shop/, features/ and "
                       "tests/scenarios/ scaffold and commit it")
    i.add_argument("--id", help="the context id: bounded-context/<domain>/<path>, its <domain> with a dot "
                   "(example.org)")
    i.add_argument("--purpose", help="the context purpose: what the bounded context is for, in a sentence or two, "
                   "written under the index file's ## Purpose")
    args = prepare(ap).parse_args(argv)
    if args.cmd in ("status", "upgrade"):
        return respond("migrate", lambda args: run_upgrade(args.cmd, getattr(args, "hook", False)), args)
    if args.cmd == "init":
        return respond("migrate", migrate_init.run, args, names={"context id": "id", "context purpose": "purpose"})
    return respond("migrate", cmd_run, args)


if __name__ == "__main__":
    __import__("adapter_cli_respond").notice("migrate")
    sys.exit(main())
