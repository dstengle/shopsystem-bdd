#!/usr/bin/env python3
"""migrate: take a repository from the old system to the final layout, in one run, deciding nothing that needs judgment.

  migrate run --context <owner/product/context>

Every change is computed first (moves, new texts, removals), checked, and only then written. Moves are `git mv`;
nothing is committed.
"""
import argparse
import sys
from pathlib import Path

from migrate_layout import Plan, check_moves, plan_ids, plan_moves, write
from migrate_ledger import plan_ledger
from migrate_spec import plan_capabilities, plan_holding, plan_index, plan_references


def cmd_run(args):
    plan = Plan(Path.cwd(), args.context)
    plan_moves(plan)
    plan_ledger(plan)
    plan_holding(plan)
    plan_index(plan)
    plan_capabilities(plan)
    plan_ids(plan)
    plan_references(plan)
    check_moves(plan)
    if plan.failures:
        print("migrate changed nothing; it could not make these changes:", file=sys.stderr)
        for failure in plan.failures:
            print("  " + failure, file=sys.stderr)
        return 1
    write(plan)
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser(prog="migrate", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("run", help="make every mechanical change, or none")
    r.add_argument("--context", required=True, help="<owner/product/context>")
    args = ap.parse_args(argv)
    return {"run": cmd_run}[args.cmd](args)


if __name__ == "__main__":
    sys.exit(main())
