#!/usr/bin/env python3
"""migrate: take a repository from the old system to the final layout, in one run, deciding nothing that needs judgment.

  migrate run --context <owner/product/context>

Every change is computed first (moves, new texts, removals), checked, and only then written. Moves are `git mv`;
nothing is committed.
"""
import argparse
import re
import posixpath
import subprocess
import sys
import tempfile
from pathlib import Path

# directory of the old system -> where it lands
DIRECTORY_MOVES = (
    ("decisions/", "spec/decisions/"),
    ("work/", ".shop/work/"),
    ("docs/superpowers/plans/", ".shop/records/archive/plans/"),
    ("docs/superpowers/specs/", ".shop/records/archive/design-notes/"),
    ("records/", ".shop/records/"),
)
LEDGER = "spec/decisions.md"
ENTRY = re.compile(r"^## decision/(?P<number>\d+)-(?P<slug>[\w-]+)\s*$")


class Plan:
    """What a run will do: files moved, texts written (new files), files removed."""

    def __init__(self, root, context):
        self.root, self.context = root, context
        self.moves = {}
        self.texts = {}
        self.removes = []
        self.failures = []      # each change that cannot be made
        self.renamed = {}       # an old id -> its new id

    def read(self, rel):
        return (self.root / rel).read_text()


def tracked(root):
    out = subprocess.run(["git", "ls-files", "-z"], cwd=root, capture_output=True, text=True, check=True).stdout
    return [p for p in out.split("\0") if p]


def destination(path):
    for old, new in DIRECTORY_MOVES:
        if path.startswith(old):
            return new + path[len(old):]
    return None


def plan_moves(plan):
    for path in tracked(plan.root):
        target = destination(path)
        if target is not None:
            plan.moves[path] = target


def ledger_entries(text):
    """(number, slug, first paragraph, fields) for each `## decision/<nnnn>-<slug>` entry of the ledger."""
    entries, current = [], None
    for line in text.splitlines():
        m = ENTRY.match(line)
        if m:
            current = [m.group("number"), m.group("slug"), []]
            entries.append(current)
        elif current is not None:
            current[2].append(line)
    out = []
    for number, slug, lines in entries:
        paragraph, fields, in_head = [], {}, True
        for line in lines:
            if in_head and line.strip():
                paragraph.append(line.strip())
                continue
            in_head = False
            m = re.match(r"^(\w+):\s*(.*)$", line)
            if m:
                fields[m.group(1)] = m.group(2).strip()
        out.append((number, slug, " ".join(paragraph), fields))
    return out


def decision_text(plan, slug, summary, fields):
    return ("---\nid: design-decision/%s/%s\nsummary: %s\ndate: %s\nstatus: accepted\nby: %s\n---\n\n# %s\n\n"
            "## Decision\n%s\n" % (plan.context, slug, summary, fields.get("date", ""), fields.get("source", ""),
                                  slug, summary))


def with_id(text, ident, kind=None):
    """`text` with `id: <ident>` (and `kind: <kind>`) first in its frontmatter, one is added when it has none;
    unchanged if it has an id."""
    given = "id: %s\n" % ident + ("kind: %s\n" % kind if kind else "")
    if text.startswith("---\n"):
        end = text.find("\n---", 4)
        if end > 0:
            if re.search(r"^id:", text[4:end], re.MULTILINE):
                return text
            return "---\n" + given + text[4:]
    return "---\n" + given + "---\n" + text


def record_kind(final):
    """The kind of a moved record that gets an id: plan, design note or test log; None for any other."""
    if final.startswith(".shop/records/archive/plans/"):
        return "initiative-archive"
    if final.startswith(".shop/records/archive/design-notes/"):
        return "decision-argument"
    if final.endswith("-test-log.md") and final.startswith(".shop/records/"):
        return "measurement"
    return None


def plan_ids(plan):
    """Give each moved plan, design note, test log and decision file the id of its kind."""
    stem = lambda rel: Path(rel).stem
    for old, final in plan.moves.items():
        text = plan.texts.get(final) or plan.read(old)
        kind = record_kind(final)
        if kind:
            plan.texts[final] = with_id(text, "%s/%s/%s" % (kind, plan.context, stem(final)), kind)
        elif final.startswith("spec/decisions/") and final.endswith(".md"):
            name = re.sub(r"^\d+-", "", stem(final))
            plan.texts[final] = with_id(text, "design-decision/%s/%s" % (plan.context, name))


def load_model():
    """scripts/model, read by path: migrate reads frontmatter the way model does."""
    import importlib.machinery
    import importlib.util
    path = str(Path(__file__).resolve().with_name("model"))
    loader = importlib.machinery.SourceFileLoader("model_by_path", path)
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader("model_by_path", loader))
    loader.exec_module(module)
    return module


BULLET_ID = re.compile(r"^- \[r(\d+)\]")


def number_behaviour(text, retired):
    """`text` with each Behaviour bullet that has no `[r<n>]` numbered, from one above the highest id ever used."""
    lines = text.split("\n")
    inside, bullets = False, []
    for i, line in enumerate(lines):
        if line.startswith("## "):
            inside = line[3:].strip().lower() == "behaviour"
        elif inside and line.startswith("- "):
            bullets.append(i)
    used = [int(m.group(1)) for i in bullets for m in [BULLET_ID.match(lines[i])] if m]
    highest = max(used + retired, default=0)
    for i in bullets:
        if not BULLET_ID.match(lines[i]):
            highest += 1
            lines[i] = "- [r%d] %s" % (highest, lines[i][2:])
    return "\n".join(lines)


def plan_capabilities(plan):
    model = load_model()
    for rel in tracked(plan.root):
        if rel.startswith("spec/capabilities/") and rel.endswith(".md"):
            text = plan.read(rel)
            data, _ = model.frontmatter(text)
            retired = [int(str(r).lstrip("r")) for r in model.as_list(data.get("retired"))]
            text = with_id(number_behaviour(text, retired), "capability/%s/%s" % (plan.context, Path(rel).stem))
            plan.texts[rel] = text


def drop_holding(text):
    out = []
    for line in text.split("\n"):
        if line.strip().startswith("@") and "@holding" in line.split():
            indent = line[:len(line) - len(line.lstrip())]
            line = indent + " ".join(t for t in line.split() if t != "@holding")
        out.append(line)
    return "\n".join(out)


def plan_holding(plan):
    """Deprecate each @holding scenario as `features deprecate` does (on a copy outside the repository), then drop
    its @holding tag."""
    model = load_model()
    features_script = str(Path(__file__).resolve().with_name("features"))
    for rel in tracked(plan.root):
        if not (rel.startswith("features/") and rel.endswith(".feature")):
            continue
        text = plan.read(rel)
        held = [title for title, tags, _ in model.scenarios(text) if "@holding" in tags]
        if not held:
            continue
        with tempfile.TemporaryDirectory() as scratch:
            copy = Path(scratch) / rel
            copy.parent.mkdir(parents=True)
            copy.write_text(text)
            for title in held:
                done = subprocess.run([sys.executable, features_script, "deprecate", title, "--for-removal", "--file", rel],
                                      cwd=scratch, capture_output=True, text=True)
                if done.returncode != 0:
                    plan.failures.append("could not deprecate %r in %s: %s" % (title, rel, (done.stdout + done.stderr).strip()))
            plan.texts[rel] = drop_holding(copy.read_text())


def plan_index(plan):
    if "spec/index.md" in tracked(plan.root):
        plan.texts["spec/index.md"] = with_id(plan.read("spec/index.md"), "bounded-context/" + plan.context)


def plan_ledger(plan):
    if LEDGER not in tracked(plan.root):
        return
    for number, slug, summary, fields in ledger_entries(plan.read(LEDGER)):
        plan.texts["spec/decisions/%s-%s.md" % (number, slug)] = decision_text(plan, slug, summary, fields)
        plan.renamed["decision/%s-%s" % (number, slug)] = "design-decision/%s/%s" % (plan.context, slug)
    plan.removes.append(LEDGER)


LINK = re.compile(r"(\]\()([^)\s#]+)((?:#[^)\s]*)?\))")


def rewrite_text(plan, old_path, new_path, text):
    """`text`, the file at `old_path` that will be at `new_path`, with each reference to what moved or was renamed
    made to name its new place: a link (relative to the file), a repository path, an id in the frontmatter."""
    def link(m):
        target = m.group(2)
        if re.match(r"^([a-z][a-z0-9+.-]*:|/)", target):
            return m.group(0)
        resolved = posixpath.normpath(posixpath.join(posixpath.dirname(old_path), target))
        if resolved not in plan.moves:
            return m.group(0)
        relative = posixpath.relpath(plan.moves[resolved], posixpath.dirname(new_path) or ".")
        return m.group(1) + relative + m.group(3)
    text = LINK.sub(link, text)
    if plan.moves:
        paths = "|".join(re.escape(p) for p in sorted(plan.moves, key=len, reverse=True))
        text = re.sub(r"(?<![\w./-])(%s)(?![\w/-])" % paths, lambda m: plan.moves[m.group(1)], text)
    if text.startswith("---\n") and plan.renamed:
        end = text.find("\n---", 4)
        head = text[:end] if end > 0 else ""
        ids = "|".join(re.escape(i) for i in plan.renamed)
        if head:
            head = re.sub(r"(?<![\w./-])(%s)(?![\w-])" % ids, lambda m: plan.renamed[m.group(1)], head)
            text = head + text[end:]
    return text


def plan_references(plan):
    """Rewrite what names a moved file or a renamed id, in every tracked text file."""
    for old in tracked(plan.root):
        if old in plan.removes:
            continue
        final = plan.moves.get(old, old)
        try:
            text = plan.texts.get(final) if final in plan.texts else plan.read(old)
        except UnicodeDecodeError:
            continue
        rewritten = rewrite_text(plan, old, final, text)
        if rewritten != text:
            plan.texts[final] = rewritten


def write(plan):
    root = plan.root
    for old, new in plan.moves.items():
        (root / new).parent.mkdir(parents=True, exist_ok=True)
        subprocess.run(["git", "mv", old, new], cwd=root, capture_output=True, text=True, check=True)
    for old in plan.moves:
        parent = (root / old).parent
        while parent != root and parent.is_dir() and not any(parent.iterdir()):
            parent.rmdir()
            parent = parent.parent
    for rel in plan.removes:
        subprocess.run(["git", "rm", "-q", rel], cwd=root, capture_output=True, text=True, check=True)
    for rel, text in plan.texts.items():
        (root / rel).parent.mkdir(parents=True, exist_ok=True)
        (root / rel).write_text(text)


def cmd_run(args):
    plan = Plan(Path.cwd(), args.context)
    plan_moves(plan)
    plan_ledger(plan)
    plan_holding(plan)
    plan_index(plan)
    plan_capabilities(plan)
    plan_ids(plan)
    plan_references(plan)
    write(plan)
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser(prog="migrate", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("run", help="make every mechanical change, or none")
    r.add_argument("--context", required=True, help="<owner/product/context>")
    args = ap.parse_args(argv)
    return {"run": cmd_run}[args.cmd](args)


if __name__ == "__main__":
    sys.exit(main())
