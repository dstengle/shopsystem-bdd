"""The fixture's handlers (tests/scenarios/work_queue_handlers.py in the end-to-end test's clone): the toy queue of
queue_cmd.py, its statuses kept in the scenario's context."""
import queue_cmd
from vocab import handler


@handler("GivenK_A", "initiative")
def given_status(step):
    step.context.setdefault("status", {})[step.names[0]] = step.values[0].strip("`")


@handler("WhenRuns", "`work start`")
def work_start(step):
    status = step.context["status"]
    status[step.names[0]], step.context["exit"] = queue_cmd.start(status[step.names[0]])


@handler("ThenK_A", "initiative")
def then_status(step):
    assert step.context["status"][step.names[0]] == step.values[0].strip("`")


@handler("ThenExitsOk")
def exits_ok(step):
    assert step.context["exit"] == 0
